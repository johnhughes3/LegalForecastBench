---
import { COURTHOUSE_PATH } from "../brand";
import "@fontsource-variable/inter";
import "@fontsource-variable/newsreader";
import "../styles/global.css";
// Preload the Latin faces every page renders with, so text does not reflow
// when the web fonts arrive (the hero stats shifted by CLS 0.11 without it).
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import newsreaderLatin from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import ThemeToggle from "../components/ThemeToggle.astro";
import { AUTHOR, REPO } from "../data/author";
import { defaultOgImage, OG_HEIGHT, OG_WIDTH } from "../og/routes";
import { crumbsFor } from "../seo/crumbs";
import { type JsonLdNode, jsonLdScript, pageGraph } from "../seo/jsonld";
import { documentTitle } from "../seo/titles";

interface Props {
	title?: string;
	description?: string;
	/** Site path of this page's social-preview PNG; defaults to its section card. */
	image?: string;
	/** Extra schema.org nodes merged into the page graph. */
	schema?: JsonLdNode[];
	/** Set on pages that must stay out of the index, such as the 404. */
	robots?: string;
}

const {
	title,
	description = "An open benchmark measuring whether frontier AI models can forecast how federal judges rule on motions to dismiss.",
	image,
	schema,
	robots,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isNotFound = /^\/404\/?$/.test(Astro.url.pathname);
const ogImage = new URL(image ?? defaultOgImage(Astro.url.pathname), Astro.site)
	.href;
const pageTitle = documentTitle(title);
const crumbs = isNotFound
	? []
	: crumbsFor(Astro.url.pathname, title ?? "LegalForecastBench");
const ogType = schema?.some((node) => node["@type"] === "ScholarlyArticle")
	? "article"
	: "website";
const graph =
	!isNotFound && Astro.site
		? pageGraph({
				site: Astro.site,
				canonical,
				title: pageTitle,
				description,
				image: ogImage,
				crumbs,
				extra: schema,
			})
		: undefined;
const path = Astro.url.pathname;
// Articles keep their pre-reorganization URLs; `also` maps them to the
// section they now belong to so the nav still marks where the reader is.
const nav = [
	{ href: "/", label: "Overview", also: [] },
	{ href: "/results/", label: "Results", also: ["/models/"] },
	{ href: "/methods/", label: "Methods", also: [] },
	{
		href: "/analysis/",
		label: "Analysis",
		also: ["/findings/", "/experiments/", "/approach/"],
	},
	{ href: "/data/", label: "Data & Code", also: [] },
];
const isActive = (item: (typeof nav)[number]) =>
	item.href === "/"
		? path === "/"
		: [item.href, ...item.also].some((prefix) => path.startsWith(prefix));
const onPaper = path.startsWith("/paper/");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		{(robots || isNotFound) && <meta name="robots" content={robots ?? "noindex"} />}
		<meta name="author" content={AUTHOR.name} />
		<meta property="og:site_name" content="LegalForecastBench" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content={String(OG_WIDTH)} />
		<meta property="og:image:height" content={String(OG_HEIGHT)} />
		<meta property="og:image:alt" content={pageTitle} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:creator" content={AUTHOR.xHandle} />
		{!isNotFound && <link rel="canonical" href={canonical} />}
		{!isNotFound && <link rel="describedby" href="/llms.txt" type="text/plain" />}
		{!isNotFound && <link rel="service-doc" href="/llms-full.txt" type="text/plain" />}
		{!isNotFound && <link rel="sitemap" href="/sitemap-index.xml" type="application/xml" />}
		{graph && <script type="application/ld+json" set:html={jsonLdScript(graph)} />}
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />
		<script is:inline>
			(() => {
				let theme = null;
				try {
					theme = localStorage.getItem("lfb-theme");
				} catch {}
				if (theme !== "light" && theme !== "dark") {
					theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body class="min-h-screen">
		<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-surface focus:px-3 focus:py-2">Skip to content</a>
		<header class="sticky top-0 z-40 border-b border-rule/80 bg-bg/85 backdrop-blur-md">
			<div class="mx-auto flex min-h-20 max-w-6xl items-center gap-3 px-4 sm:gap-6 sm:px-6">
				<div class="shrink-0 py-3">
					<a href="/" class="flex items-center gap-2.5 font-serif text-[1.25rem] font-medium tracking-tight text-ink sm:text-[1.4rem]">
						<svg class="h-7 w-6 text-[#781d2b] dark:text-[#faf9f6]" viewBox="0 0 32 35" aria-hidden="true"><path d={COURTHOUSE_PATH} fill="currentColor" /></svg>
						LegalForecastBench
					</a>
					<a href="https://www.legalquants.com/" class="mt-1 flex items-center gap-3 pl-[2.125rem] text-[11px] text-ink-2">
						<span>In partnership with LegalQuants</span>
						<img src="/brand/legalquants.svg" width="24" height="24" alt="" />
					</a>
				</div>
				<nav class="ml-auto hidden items-center gap-1 text-sm lg:flex" aria-label="Primary">
					{nav.map((item) => (
						<a
							href={item.href}
							class:list={[
								"rounded-full px-3 py-1.5 transition",
								isActive(item) ? "bg-surface-2 font-medium text-ink" : "text-ink-2 hover:text-ink",
							]}
							aria-current={isActive(item) ? "page" : undefined}
						>
							{item.label}
						</a>
					))}
				</nav>
				<div class="ml-auto flex items-center gap-2 lg:ml-0">
					<a
						href="/paper/"
						aria-current={onPaper ? "page" : undefined}
						class="hidden shrink-0 rounded-full bg-ink px-3 py-1.5 text-sm font-medium text-bg transition hover:opacity-90 sm:inline-flex"
					>Read the paper</a>
					<ThemeToggle />
				</div>
			</div>
			<nav id="mobile-nav" class="nav-scroll mx-auto flex max-w-6xl gap-1 overflow-x-auto px-3 pr-12 pb-2 text-sm lg:hidden" aria-label="Primary (mobile)">
				<a href="/paper/" aria-current={onPaper ? "page" : undefined} class="sticky left-0 z-10 shrink-0 rounded-full bg-ink px-3 py-1 font-medium text-bg shadow-[0.5rem_0_0.5rem_-0.25rem_var(--bg)] sm:hidden">Paper</a>
				{nav.map((item) => (
					<a href={item.href} aria-current={isActive(item) ? "page" : undefined} class:list={["shrink-0 rounded-full px-3 py-1", isActive(item) ? "bg-surface-2 font-medium text-ink" : "text-ink-2"]}>{item.label}</a>
				))}
			</nav>
			<script is:inline>
				// Phones: center the current section, and keep a keyboard-focused
				// link clear of the trailing fade and of the pinned paper link
				// (native focus scrolling stops at the edges, which they cover).
				(() => {
					const nav = document.getElementById("mobile-nav");
					if (!nav) return;
					const FADE = 48;
					const offset = (link) => link.getBoundingClientRect().left - nav.getBoundingClientRect().left;
					const current = nav.querySelector('[aria-current="page"]');
					if (current && nav.scrollWidth > nav.clientWidth)
						nav.scrollLeft += offset(current) - (nav.clientWidth - current.clientWidth) / 2;
					const pinned = nav.querySelector(".sticky");
					nav.addEventListener("focusin", (event) => {
						const link = event.target;
						if (link === pinned) return;
						const lead = pinned ? pinned.offsetWidth + 8 : 0;
						const left = offset(link);
						const overflow = left + link.offsetWidth - (nav.clientWidth - FADE);
						if (overflow > 0) nav.scrollLeft += overflow;
						else if (left < lead) nav.scrollLeft += left - lead - 12;
					});
				})();
			</script>
		</header>
		<main id="main">
			{crumbs.length > 1 && (
				<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
					<ol class="flex flex-wrap items-center gap-x-2 text-sm text-ink-3">
						{crumbs.map((crumb, index) => (
							<li class="flex items-center gap-x-2">
								{index > 0 && <span aria-hidden="true">/</span>}
								{index === crumbs.length - 1 ? (
									<span class="text-ink-2">{crumb.name}</span>
								) : (
									<a class="hover:text-ink" href={crumb.path}>{crumb.name}</a>
								)}
							</li>
						))}
					</ol>
				</nav>
			)}
			<slot />
		</main>
		<footer class="mt-24 border-t border-rule">
			<div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 text-sm text-ink-3 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
				<div class="space-y-3">
					<p class="font-serif text-base font-semibold text-ink">LegalForecastBench</p>
					<p>An independent, open-source research benchmark by <a class="text-ink-2 underline decoration-rule-strong underline-offset-2 hover:text-ink" href={AUTHOR.site}>{AUTHOR.name}</a>. Published predictions are retrospective research artifacts about matters already decided. They are not legal advice.</p>
					<p>In partnership with LegalQuants, which supports its distribution. Harvey AI, Harvey LAB, and Vals AI are not sponsors, partners, or endorsers of this work. Provider names identify the measured product surface only.</p>
				</div>
				<div class="space-y-2">
					<p class="font-medium text-ink-2">Explore</p>
					<ul class="space-y-1.5">
						{nav.map((item) => <li><a class="hover:text-ink" href={item.href}>{item.label}</a></li>)}
						<li><a class="hover:text-ink" href="/paper/">Working paper</a></li>
					</ul>
				</div>
				<div class="space-y-2">
					<p class="font-medium text-ink-2">Author and project</p>
					<ul class="space-y-1.5">
						<li><a class="hover:text-ink" href={AUTHOR.research}>{AUTHOR.name}: research</a></li>
						<li><a class="hover:text-ink" href={AUTHOR.contact}>Contact</a></li>
						<li><a class="hover:text-ink" href={AUTHOR.linkedin}>LinkedIn</a></li>
						<li><a class="hover:text-ink" href={AUTHOR.x}>X</a></li>
						<li><a class="hover:text-ink" href={REPO}>Source on GitHub</a></li>
						<li>Code under Apache License 2.0</li>
						<li><a class="hover:text-ink" href="https://creativecommons.org/licenses/by/4.0/">Data under CC BY 4.0</a></li>
					</ul>
				</div>
			</div>
		</footer>
	</body>
</html>

<script>
	import "../scripts/tooltips";
</script>
