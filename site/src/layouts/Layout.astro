---
import "@fontsource-variable/inter";
import "@fontsource-variable/newsreader";
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title,
	description = "An open benchmark measuring whether frontier AI models can forecast how federal judges rule on motions to dismiss.",
} = Astro.props;
const pageTitle = title
	? `${title} · LegalForecastBench`
	: "LegalForecastBench";
const path = Astro.url.pathname;
const nav = [
	{ href: "/", label: "Results" },
	{ href: "/findings/", label: "Findings" },
	{ href: "/methods/", label: "Methods" },
	{ href: "/data/", label: "Data" },
];
const isActive = (href: string) =>
	href === "/" ? path === "/" : path.startsWith(href);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<script is:inline>
			(() => {
				let theme = null;
				try {
					theme = localStorage.getItem("lfb-theme");
				} catch {}
				if (theme !== "light" && theme !== "dark") {
					theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body class="min-h-screen">
		<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-surface focus:px-3 focus:py-2">Skip to content</a>
		<header class="sticky top-0 z-40 border-b border-rule/80 bg-bg/85 backdrop-blur-md">
			<div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6">
				<a href="/" class="flex items-center gap-2.5 font-serif text-[1.15rem] font-semibold tracking-tight text-ink">
					<svg class="size-6 text-accent" viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="3" width="26" height="26" rx="7" fill="currentColor" /><path d="M10 21.5 14.5 16l3.2 3.2L23 11" fill="none" stroke="var(--bg)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
					LegalForecastBench
					<span class="rounded-full border border-accent/30 bg-accent-soft px-2 py-0.5 font-sans text-[10px] font-semibold uppercase tracking-wider text-accent">Beta</span>
				</a>
				<nav class="ml-auto hidden items-center gap-1 text-sm sm:flex" aria-label="Primary">
					{nav.map((item) => (
						<a
							href={item.href}
							class:list={[
								"rounded-full px-3 py-1.5 transition",
								isActive(item.href) ? "bg-surface-2 font-medium text-ink" : "text-ink-2 hover:text-ink",
							]}
							aria-current={isActive(item.href) ? "page" : undefined}
						>
							{item.label}
						</a>
					))}
				</nav>
				<a href="https://github.com/johnhughes3/LegalForecastBench" class="hidden text-sm text-ink-2 hover:text-ink md:inline">GitHub</a>
				<div class="ml-auto sm:ml-0"><ThemeToggle /></div>
			</div>
			<nav class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-3 pb-2 text-sm sm:hidden" aria-label="Primary (mobile)">
				{nav.map((item) => (
					<a href={item.href} class:list={["shrink-0 rounded-full px-3 py-1", isActive(item.href) ? "bg-surface-2 font-medium text-ink" : "text-ink-2"]}>{item.label}</a>
				))}
			</nav>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer class="mt-24 border-t border-rule">
			<div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 text-sm text-ink-3 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
				<div class="space-y-3">
					<p class="font-serif text-base font-semibold text-ink">LegalForecastBench</p>
					<p class="text-ink-2">LegalForecastBench is a public beta. We are refining and improving the benchmark as we go.</p>
					<p>An independent, open-source academic benchmark. Published predictions are retrospective research artifacts about matters already decided. They are not legal advice.</p>
					<p>Harvey AI, Harvey LAB, Vals AI, and LegalQuants are not sponsors, partners, or endorsers of this work. Provider names identify the measured product surface only.</p>
				</div>
				<div class="space-y-2">
					<p class="font-medium text-ink-2">Explore</p>
					<ul class="space-y-1.5">
						<li><a class="hover:text-ink" href="/">Results</a></li>
						<li><a class="hover:text-ink" href="/findings/">Findings</a></li>
						<li><a class="hover:text-ink" href="/methods/">Methods</a></li>
						<li><a class="hover:text-ink" href="/data/">Data and reproduction</a></li>
					</ul>
				</div>
				<div class="space-y-2">
					<p class="font-medium text-ink-2">Project</p>
					<ul class="space-y-1.5">
						<li><a class="hover:text-ink" href="https://github.com/johnhughes3/LegalForecastBench">Source on GitHub</a></li>
						<li><a class="hover:text-ink" href="https://johnjhughes3.com">John J. Hughes, III</a></li>
						<li>Code under Apache License 2.0</li>
					</ul>
				</div>
			</div>
		</footer>
	</body>
</html>
