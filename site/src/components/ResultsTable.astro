---
import { formatPercent, formatUsd, METRICS } from "../data/metrics";
import type { ResultsSnapshot } from "../data/snapshot";

interface Props {
	snapshot: ResultsSnapshot;
}
const { snapshot } = Astro.props;
const n = snapshot.cohort.unit_count;
const rows = [...snapshot.models].sort((a, b) => a.micro_brier - b.micro_brier);
---

<figure class="not-serif">
	<div class="overflow-x-auto rounded-xl border border-rule">
		<table class="w-full min-w-[560px] border-collapse text-left text-sm">
			<caption class="sr-only">Results by model, sorted by micro Brier. Lower Brier is better.</caption>
			<thead class="border-b border-rule bg-surface-2/60 text-xs text-ink-3">
				<tr>
					<th scope="col" class="px-3 py-2.5 font-medium">Model</th>
					<th scope="col" class="px-3 py-2.5 text-right font-medium">Micro Brier ↓</th>
					<th scope="col" class="px-3 py-2.5 text-right font-medium">Equal-case ↓</th>
					<th scope="col" class="px-3 py-2.5 text-right font-medium">Accuracy ↑</th>
					<th scope="col" class="px-3 py-2.5 text-right font-medium">Cost</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-rule">
				{rows.map((m) => (
					<tr>
						<th scope="row" class="px-3 py-2 font-medium text-ink"><a class="hover:text-accent" href={`/models/${m.slug}/`}>{m.display_name}</a></th>
						<td class="px-3 py-2 text-right tabular text-ink">{METRICS.micro_brier.format(m.micro_brier)}</td>
						<td class="px-3 py-2 text-right tabular text-ink-2">{METRICS.equal_case_brier.format(m.equal_case_brier)}</td>
						<td class="px-3 py-2 text-right tabular text-ink-2">{formatPercent(m.correct / n)}</td>
						<td class="px-3 py-2 text-right tabular text-ink-2">{formatUsd(m.cost.usd)}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
	<figcaption class="mt-2 text-xs text-ink-2">Costs are estimated standard-rate costs for the {snapshot.cohort.case_count}-case workload, not invoices. <a class="text-accent hover:underline" href="/data/run-notes/#costs">Cost methodology</a>.</figcaption>
</figure>
