---
// Both citations come from the repository's CITATION.cff at build time: the
// paper from its `preferred-citation` block, the software from the fields above it.
import cff from "../../../CITATION.cff?raw";
import {
	parseCitation,
	toApa,
	toBibtex,
	toPaperApa,
	toPaperBibtex,
} from "../data/citation";
import { PAPER_CITATION } from "../data/paper";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const software = parseCitation(cff);
const groups = [
	{
		id: "paper",
		label: "Working paper",
		detail: `First posted ${PAPER_CITATION.date}. Cite this for the benchmark and its results.`,
		bibtex: toPaperBibtex(PAPER_CITATION),
		apa: toPaperApa(PAPER_CITATION),
	},
	{
		id: "software",
		label: "Software",
		detail: `Release ${software.version ?? software.date}. Cite this to identify the code you ran.`,
		bibtex: toBibtex(software),
		apa: toApa(software),
	},
];
---

<section class:list={["card p-6", className]} aria-labelledby="cite-heading" data-cite-box>
	<h2 id="cite-heading" class="font-serif text-xl font-semibold">How to cite</h2>
	<p class="mt-1 text-sm text-ink-3">From the repository's <a class="text-accent hover:underline" href="https://github.com/johnhughes3/LegalForecastBench/blob/main/CITATION.cff">CITATION.cff</a>.</p>
	{groups.map((group) => (
		<div class="mt-6" data-cite-group={group.id}>
			<h3 class="font-medium text-ink">{group.label}</h3>
			<p class="mt-1 text-sm text-ink-3">{group.detail}</p>
			<div class="mt-4 space-y-5">
				{[
					{ id: `cite-${group.id}-bibtex`, label: "BibTeX", text: group.bibtex, mono: true },
					{ id: `cite-${group.id}-apa`, label: "APA", text: group.apa, mono: false },
				].map((f) => (
					<div>
						<div class="flex items-center justify-between gap-3">
							<h4 class="text-sm font-medium text-ink-2" id={`${f.id}-label`}>{f.label}</h4>
							<button
								type="button"
								hidden
								data-copy-target={f.id}
								class="rounded-full border border-rule-strong px-3 py-1 text-xs font-medium text-ink hover:border-ink"
								aria-label={`Copy ${group.label.toLowerCase()} ${f.label} citation`}
							>
								Copy
							</button>
						</div>
						{f.mono ? (
							<pre id={f.id} class="mt-2 overflow-x-auto rounded-lg bg-surface-2 p-4 font-mono text-[13px] leading-relaxed text-ink" tabindex="0" aria-labelledby={`${f.id}-label`}>{f.text}</pre>
						) : (
							<p id={f.id} class="mt-2 rounded-lg bg-surface-2 p-4 text-sm leading-relaxed break-words text-ink">{f.text}</p>
						)}
					</div>
				))}
			</div>
		</div>
	))}
	<p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
</section>

<script>
	// Copy buttons stay hidden without JavaScript or clipboard access; the text itself remains selectable.
	for (const box of document.querySelectorAll<HTMLElement>("[data-cite-box]")) {
		const status = box.querySelector<HTMLElement>("[data-copy-status]");
		for (const button of box.querySelectorAll<HTMLButtonElement>("[data-copy-target]")) {
			if (!navigator.clipboard) continue;
			button.hidden = false;
			button.addEventListener("click", async () => {
				const target = document.getElementById(button.dataset.copyTarget ?? "");
				if (!target) return;
				try {
					await navigator.clipboard.writeText(target.textContent ?? "");
					button.textContent = "Copied";
					if (status) status.textContent = "Citation copied to clipboard.";
				} catch {
					button.textContent = "Copy failed";
					if (status) status.textContent = "Copy failed. Select the text to copy it.";
				}
				setTimeout(() => {
					button.textContent = "Copy";
				}, 2000);
			});
		}
	}
</script>
