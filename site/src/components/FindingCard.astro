---
import type { CollectionEntry } from "astro:content";

interface Props {
	entry: CollectionEntry<"findings">;
}
const { entry } = Astro.props;
const kindLabel = { report: "Report", note: "Note", critique: "Critique" }[
	entry.data.kind
];
const date = entry.data.date.toLocaleDateString("en-US", {
	month: "long",
	day: "numeric",
	year: "numeric",
	timeZone: "UTC",
});
---

<a href={`/findings/${entry.id}/`} class="card group flex flex-col p-5 transition hover:-translate-y-0.5 hover:border-rule-strong hover:shadow-sm">
	<div class="flex items-center gap-2 text-xs text-ink-3">
		<span class="eyebrow">{kindLabel}</span>
		<span aria-hidden="true">·</span>
		<time datetime={entry.data.date.toISOString()}>{date}</time>
		{entry.data.draft && <span class="rounded-full bg-accent-soft px-2 py-0.5 font-medium text-accent">Draft</span>}
	</div>
	<h3 class="mt-3 font-serif text-xl font-semibold leading-snug tracking-tight text-ink group-hover:text-accent">{entry.data.title}</h3>
	<p class="mt-2 text-sm leading-relaxed text-ink-2">{entry.data.summary}</p>
</a>
