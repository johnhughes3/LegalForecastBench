---
import { formatPercent, METRICS } from "../../data/metrics";
import { snapshot } from "../../data/results";
import Stat from "../Stat.astro";

// Every figure below is read from the published snapshot so this summary
// cannot drift from the leaderboard it describes.
const { cohort } = snapshot;
const { bootstrap } = cohort;
const baseRate = cohort.dismissed_unit_count / cohort.unit_count;

const day = (iso: string, options: Intl.DateTimeFormatOptions): string =>
	new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
		timeZone: "UTC",
		...options,
	});
const { start, end } = cohort.decision_window;
const windowStart = day(start, { month: "long", day: "numeric" });
const windowEnd = day(end, { month: "long", day: "numeric", year: "numeric" });
// Non-breaking spaces keep each date whole so a narrow stat wraps only after the dash.
const shortDay = (iso: string): string =>
	day(iso, { month: "short", day: "numeric" }).replace(" ", "\u00a0");
const shortWindow = `${shortDay(start)} – ${shortDay(end)}`;
const decisionYear = end.slice(0, 4);

const sections = [
	{ id: "task", label: "Task" },
	{ id: "scoring", label: "Scoring" },
	{ id: "eligibility", label: "Eligibility" },
	{ id: "uncertainty", label: "Uncertainty" },
	{ id: "costs", label: "Costs" },
	{ id: "limits", label: "Limits" },
	{ id: "full-methods", label: "Full technical methods" },
];

const flow = [
	{
		step: "Pre-decision record",
		body: "The docket and filed motion papers, such as the complaint, motion, opposition, and reply.",
	},
	{
		step: "Model with document tools",
		body: "A common tool-enabled harness gives the model access to the record, in a sandbox with Internet access disabled.",
	},
	{
		step: "A probability per unit",
		body: "For each claim-defendant unit, the chance it is fully dismissed, with a short rationale.",
	},
	{
		step: "Scored against the ruling",
		body: "The court's written disposition, withheld from the model, supplies the outcome.",
	},
];

const scoring = [
	{
		name: METRICS.micro_brier.label,
		role: "Headline",
		body: "The squared gap between forecast and outcome, averaged over every scored unit. 0 is perfect; lower is better.",
	},
	{
		name: METRICS.equal_case_brier.label,
		role: "Sensitivity",
		body: "The same score averaged within each case first, so a motion with many units does not dominate. Reported alongside the headline.",
	},
	{
		name: METRICS.accuracy.label,
		role: "Secondary",
		body: "A forecast of at least 50% counts as predicting dismissal. Easy to read, but it ignores how confident the forecast was.",
	},
];

const limits = [
	{
		title: "Prediction is not reasoning",
		body: "A model could forecast well by modeling a judge's tendencies rather than the law. Scores are a hypothesized proxy for legal reasoning, not a direct measure of it.",
	},
	{
		title: "The task is narrow",
		body: "Motions to dismiss in federal court are one decision point in one court system. Results say nothing directly about other legal work.",
	},
	{
		title: "Versions are not comparable",
		body: "Each version uses new cases with a different mix and difficulty, so scores measure a point in time and are not directly comparable across versions.",
	},
	{
		title: "Provider settings vary",
		body: "Requests use each provider's default sampling settings, and serving can change. Fixed prompts make variation observable but do not make it deterministic.",
	},
];
---

<header class="max-w-3xl">
	<p class="eyebrow">Methods</p>
	<h1 class="mt-3 font-serif text-4xl font-medium leading-tight tracking-tight sm:text-5xl">How the benchmark works</h1>
	<p class="mt-5 text-lg leading-relaxed text-ink-2">
		Models read the written pre-decision record of a federal motion to dismiss, then forecast how each challenged claim will come out. We score those probabilities against what the court actually decided.
	</p>
	<p class="mt-4 text-sm leading-relaxed text-ink-3">
		This page summarizes the method for readers. For why outcome-based evaluation is worth doing, see the <a class="text-accent underline" href="/approach/">approach</a>. Separate studies, such as forecasting from summaries, are on the <a class="text-accent underline" href="/experiments/">experiments</a> page.
	</p>
</header>

<nav class="mt-8" aria-label="Methods sections">
	<ul class="flex flex-wrap gap-2 text-sm">
		{sections.map((s) => (
			<li>
				<a class="inline-block rounded-full border border-rule px-3 py-1 text-ink-2 hover:border-rule-strong hover:text-ink" href={`#${s.id}`}>{s.label}</a>
			</li>
		))}
	</ul>
</nav>

<div class="mt-12 grid grid-cols-2 gap-y-8 sm:grid-cols-4" aria-label="Current cohort">
	<Stat value={String(cohort.case_count)} label="Cases" detail="Federal motions to dismiss" />
	<Stat value={String(cohort.unit_count)} label="Scored units" detail="Claim × defendant pairs" />
	<Stat value={shortWindow} label={`Decisions, ${decisionYear}`} detail="Written dispositions in the cohort" />
	<Stat value={formatPercent(baseRate)} label="Units dismissed" detail={`${cohort.dismissed_unit_count} of ${cohort.unit_count}`} />
</div>

<section id="task" class="mt-20 scroll-mt-24">
	<p class="eyebrow">The task</p>
	<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">One forecast for each claim against each defendant</h2>

	<ol class="mt-8 grid gap-3 md:grid-cols-4" aria-label="From record to score">
		{flow.map((item, i) => (
			<li class={`card relative min-w-0 p-5 ${i === flow.length - 1 ? "border-dashed" : ""}`}>
				<p class="font-serif text-sm text-accent">0{i + 1}</p>
				<h3 class="mt-2 font-serif text-lg font-semibold">{item.step}</h3>
				<p class="mt-2 text-sm leading-relaxed text-ink-2">{item.body}</p>
				{i < flow.length - 1 && <span class="absolute -right-2.5 top-1/2 hidden -translate-y-1/2 text-rule-strong md:block" aria-hidden="true">→</span>}
			</li>
		))}
	</ol>

	<dl class="mt-8 grid gap-4 md:grid-cols-2">
		<div class="card min-w-0 p-5">
			<dt class="font-serif text-lg font-semibold">Prediction unit</dt>
			<dd class="mt-2 text-sm leading-relaxed text-ink-2">One challenged claim against one defendant or defendant group. A motion attacking five claims against two separately scored defendant groups yields ten units.</dd>
		</div>
		<div class="card min-w-0 p-5">
			<dt class="font-serif text-lg font-semibold">Target</dt>
			<dd class="mt-2 text-sm leading-relaxed text-ink-2">Whether the unit is fully dismissed in the motion's first written disposition. The model gives a probability from 0 to 1.</dd>
		</div>
		<div class="card min-w-0 p-5">
			<dt class="flex items-center gap-2 font-medium text-ink"><span class="size-2 shrink-0 rounded-full bg-good" aria-hidden="true"></span>Counts as dismissed</dt>
			<dd class="mt-2 text-sm leading-relaxed text-ink-2">Dismissal with leave to amend. The court dismissed the claim; the chance to replead does not change that.</dd>
		</div>
		<div class="card min-w-0 p-5">
			<dt class="flex items-center gap-2 font-medium text-ink"><span class="size-2 shrink-0 rounded-full bg-critical" aria-hidden="true"></span>Does not count as dismissed</dt>
			<dd class="mt-2 text-sm leading-relaxed text-ink-2">A motion mooted because the plaintiff amended the complaint first. No court dismissed the claim.</dd>
		</div>
	</dl>

	<div class="mt-8 max-w-3xl space-y-3 text-sm leading-relaxed text-ink-2">
		<p><strong class="font-medium text-ink">What models receive.</strong> Every model gets the same pre-decision docket and filings through the same document-tool harness and prompt. Model-visible text is screened for outcome leakage, and the written disposition being predicted is excluded.</p>
		<p><strong class="font-medium text-ink">The cohort.</strong> {cohort.case_count} cases and {cohort.unit_count} scored units, with written decisions dated {windowStart} to {windowEnd}. Models forecast 409 units; 22 are not scoreable under the locked answer key, leaving {cohort.unit_count}. Predictions are retrospective research artifacts about decided matters, not legal advice.</p>
	</div>
</section>

<section id="scoring" class="mt-20 scroll-mt-24">
	<p class="eyebrow">Scoring</p>
	<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">Brier score rewards calibrated confidence</h2>
	<p class="mt-4 max-w-3xl leading-relaxed text-ink-2">
		A forecast of 90% on a claim that is dismissed costs little; the same forecast on a claim that survives costs a lot. The Brier score is (forecast − outcome)², so confident mistakes are penalized far more than hedged ones.
	</p>

	<div class="mt-8 grid gap-4 md:grid-cols-3">
		{scoring.map((m) => (
			<div class="card min-w-0 p-5">
				<p class="eyebrow">{m.role}</p>
				<h3 class="mt-2 font-serif text-lg font-semibold">{m.name}</h3>
				<p class="mt-2 text-sm leading-relaxed text-ink-2">{m.body}</p>
			</div>
		))}
	</div>

	<div class="card mt-4 min-w-0 p-5">
		<h3 class="font-serif text-lg font-semibold">Baselines to beat</h3>
		<dl class="mt-3 divide-y divide-rule text-sm">
			<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
				<dt class="text-ink-2">Always forecast 50%</dt>
				<dd class="font-medium text-ink tabular">{METRICS.micro_brier.format(0.25)} micro Brier</dd>
			</div>
			<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
				<dt class="text-ink-2">Always forecast the cohort's dismissal rate ({formatPercent(baseRate)})</dt>
				<dd class="font-medium text-ink tabular">{METRICS.micro_brier.format(cohort.constant_forecast_micro_brier)} micro Brier</dd>
			</div>
			<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
				<dt class="text-ink-2">Always predict dismissal</dt>
				<dd class="font-medium text-ink tabular">{METRICS.accuracy.format(cohort.majority_class_accuracy)} accuracy</dd>
			</div>
		</dl>
		<p class="mt-2 text-xs leading-relaxed text-ink-3">The dismissal-rate forecast is computed with hindsight from the cohort's own outcomes, which no model sees.</p>
	</div>
</section>

<section id="eligibility" class="mt-20 scroll-mt-24">
	<p class="eyebrow">Eligibility</p>
	<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">Decisions must postdate what a model was trained on</h2>
	<div class="mt-8 grid gap-4 md:grid-cols-2">
		<div class="card min-w-0 p-5">
			<h3 class="font-serif text-lg font-semibold">Eligible comparison</h3>
			<p class="mt-2 text-sm leading-relaxed text-ink-2">The provider-reported training-data or knowledge cutoff falls before the first scored decision. A month-only cutoff counts if its month is no later than the first decision's month, since ingesting a decision the day it issued is implausible. A model's public release date does not decide eligibility.</p>
		</div>
		<div class="card min-w-0 p-5">
			<h3 class="font-serif text-lg font-semibold">Qualified comparison</h3>
			<p class="mt-2 text-sm leading-relaxed text-ink-2">No cutoff has been published, or the reported cutoff falls after the first decision. Those results must carry a visible qualification rather than appear as eligible.</p>
		</div>
	</div>
	<p class="mt-4 max-w-3xl text-sm leading-relaxed text-ink-2">
		A provider's stated cutoff is evidence, not proof: it cannot rule out every exposure in training or post-training. Limited contamination is a working assumption, and a lack of score differences would not prove there was none.
	</p>
</section>

<section id="uncertainty" class="mt-20 scroll-mt-24">
	<p class="eyebrow">Uncertainty</p>
	<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">Small differences between models may be noise</h2>
	<div class="mt-8 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
		<div class="card min-w-0 p-5">
			<h3 class="font-serif text-lg font-semibold">Pairwise significance</h3>
			<dl class="mt-3 divide-y divide-rule text-sm">
				<div class="grid gap-1 py-3 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-4">
					<dt class="text-ink-3">Method</dt>
					<dd class="text-ink">{bootstrap.method}</dd>
				</div>
				<div class="grid gap-1 py-3 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-4">
					<dt class="text-ink-3">Resamples</dt>
					<dd class="text-ink tabular">{bootstrap.replicates.toLocaleString("en-US")}</dd>
				</div>
				<div class="grid gap-1 py-3 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-4">
					<dt class="text-ink-3">Correction</dt>
					<dd class="text-ink">{bootstrap.correction}</dd>
				</div>
			</dl>
			<p class="mt-2 text-sm leading-relaxed text-ink-2">Cases are resampled whole, so units from the same motion move together.</p>
		</div>
		<div class="card min-w-0 p-5">
			<h3 class="font-serif text-lg font-semibold">Read results cautiously</h3>
			<ul class="mt-3 space-y-3 text-sm leading-relaxed text-ink-2">
				<li><strong class="font-medium text-ink">Scope.</strong> {bootstrap.caveat}</li>
				<li><strong class="font-medium text-ink">One run per model.</strong> Each configuration contributed one retained forecast per unit. Run-to-run variance was not measured.</li>
			</ul>
		</div>
	</div>
</section>

<section id="costs" class="mt-20 scroll-mt-24">
	<p class="eyebrow">Costs</p>
	<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">Standard-rate estimates, not invoices</h2>
	<p class="mt-4 max-w-3xl leading-relaxed text-ink-2">
		Reported costs price each model's token usage for the same successful {cohort.case_count}-case workload at the provider's standard API rates, so models can be compared on equal terms. They are not provider invoices or total experiment spending: actual charges differed, for example where discounted pricing tiers applied. Where usage records were incomplete, costs were reconstructed from saved token usage and are labeled as estimates. See <a class="text-accent underline" href="/data/">data</a> for details.
	</p>
</section>

<section id="limits" class="mt-20 scroll-mt-24">
	<p class="eyebrow">Limits</p>
	<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">What the scores do not tell you</h2>
	<div class="mt-8 grid gap-4 sm:grid-cols-2">
		{limits.map((l) => (
			<div class="card min-w-0 p-5">
				<h3 class="font-serif text-lg font-semibold">{l.title}</h3>
				<p class="mt-2 text-sm leading-relaxed text-ink-2">{l.body}</p>
			</div>
		))}
	</div>
</section>
