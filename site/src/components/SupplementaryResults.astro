---
import { METRICS } from "../data/metrics";
import type { SupplementaryRow } from "../data/supplementary-results";

interface Props {
	rows: SupplementaryRow[];
}

const { rows } = Astro.props;
const referenceLabel = (role: SupplementaryRow["role"]): string | null =>
	role === "reasoning-reference"
		? "Reasoning reference"
		: role === "full-record-reference"
			? "Full-record reference"
			: null;
---

<section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6" id="supplementary" aria-labelledby="supplementary-heading">
	<div class="overflow-hidden rounded-2xl border border-rule-strong bg-surface-2">
		<div class="border-b border-rule px-5 py-7 sm:px-8">
			<p class="eyebrow">Additional comparisons</p>
			<h2 id="supplementary-heading" class="mt-2 font-serif text-3xl font-semibold tracking-tight">Summary-based and minimal-reasoning tests</h2>
			<p class="mt-4 max-w-3xl text-sm leading-relaxed text-ink-2">These experiments use different inputs or reasoning settings from the main benchmark. Summary-based models receive a saved summary packet in one turn. Reasoning and full-record references are labelled separately, so their scores can be read in context.</p>
		</div>
		<p class="px-5 pt-3 text-xs text-ink-3 sm:hidden">Swipe the table to see scores →</p>
		<div class="overflow-x-auto">
			<table class="w-full min-w-[760px] border-collapse text-left text-sm">
				<caption class="sr-only">Additional forecast comparisons. Lower Brier scores and higher accuracy are better. Inputs and reasoning settings differ across rows.</caption>
				<thead class="border-b border-rule text-xs text-ink-3">
					<tr>
						<th scope="col" class="px-5 py-4 font-medium sm:pl-8">Model</th>
						<th scope="col" class="px-4 py-4 font-medium">Input</th>
						<th scope="col" class="px-4 py-4 font-medium">Reasoning</th>
						<th scope="col" class="px-4 py-4 text-right font-medium">Micro Brier</th>
						<th scope="col" class="px-4 py-4 text-right font-medium">Equal-case Brier</th>
						<th scope="col" class="px-5 py-4 text-right font-medium sm:pr-8">Accuracy</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-rule">
					{rows.map((row) => (
						<tr class={row.role === "comparison" ? "bg-surface/70" : "bg-surface-2"}>
							<th scope="row" class="px-5 py-4 font-medium text-ink sm:pl-8">
								<a href={row.source_url} class="hover:text-accent hover:underline">{row.display_name}</a>
								{row.reasoning_label === "Off" && <span class="mt-1.5 block w-fit rounded-full border border-rule-strong px-2 py-0.5 text-[11px] font-normal text-ink-2">Minimal reasoning comparison</span>}
								{referenceLabel(row.role) && <span class="mt-1.5 block w-fit rounded-full border border-rule-strong px-2 py-0.5 text-[11px] font-normal text-ink-2">{referenceLabel(row.role)}</span>}
								<span class="mt-1.5 block text-xs font-normal text-ink-3">{row.case_count} cases · {row.unit_count} units</span>
							</th>
							<td class="px-4 py-4 text-ink-2">{row.input_label}</td>
							<td class="px-4 py-4 text-ink-2">{row.reasoning_label}</td>
							<td class="px-4 py-4 text-right tabular text-ink">{METRICS.micro_brier.format(row.micro_brier)}</td>
							<td class="px-4 py-4 text-right tabular text-ink">{METRICS.equal_case_brier.format(row.equal_case_brier)}</td>
							<td class="px-5 py-4 text-right tabular text-ink sm:pr-8">{METRICS.accuracy.format(row.correct / row.unit_count)}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		<div class="border-t border-rule px-5 py-4 text-xs text-ink-3 sm:px-8">
			Lower Brier is better; higher accuracy is better. <a href="/data/#supplementary" class="font-medium text-accent hover:underline">Data and comparison details →</a>
		</div>
	</div>
</section>
