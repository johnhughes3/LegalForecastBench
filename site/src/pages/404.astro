---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" robots="noindex">
	<section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
		<p class="eyebrow">404</p>
		<h1 class="mt-3 font-serif text-4xl font-medium">Motion denied</h1>
		<p class="mt-4 text-ink-2">That page does not exist.</p>
		<a href="/" class="mt-8 inline-flex text-accent hover:underline">Back to results</a>
	</section>
</Layout>
