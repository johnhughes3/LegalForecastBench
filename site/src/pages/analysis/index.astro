---
import {
	analysisItems,
	CURRENT_RELEASE,
	EVIDENCE_LABELS,
	GROUPS,
} from "../../data/analysis";
import Layout from "../../layouts/Layout.astro";

const items = await analysisItems();
const fmt = (date: Date) =>
	date.toLocaleDateString("en-US", {
		month: "long",
		day: "numeric",
		year: "numeric",
		timeZone: "UTC",
	});
---

<Layout title="Analysis" description="Essays, reports, experiments, and audit notes on LegalForecastBench, each marked with its date, the release it analyzes, and how much evidence it carries.">
	<section class="mx-auto max-w-6xl px-4 pt-14 sm:px-6">
		<p class="eyebrow">Analysis</p>
		<h1 class="mt-3 max-w-3xl font-serif text-4xl font-medium tracking-tight sm:text-5xl">What the forecasts show, and why the task matters</h1>
		<p class="mt-5 max-w-2xl text-lg text-ink-2">
			The rationale for the benchmark, the release report, closer looks at where models lost points, controlled experiments, and ongoing research. Each item states its date, the results release it analyzes ({CURRENT_RELEASE} unless noted), and how much weight its evidence can bear.
		</p>
		{GROUPS.map(({ key, title, blurb }) => {
			const entries = items.filter((item) => item.group === key);
			return entries.length > 0 && (
				<div class="mt-14">
					<h2 class="font-serif text-2xl font-semibold tracking-tight">{title}</h2>
					<p class="mt-1 text-sm text-ink-3">{blurb}</p>
					<div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
						{entries.map((item) => (
							<a href={item.href} class="card group flex flex-col p-5 transition hover:-translate-y-0.5 hover:border-rule-strong hover:shadow-sm">
								<div class="flex flex-wrap items-center gap-2 text-xs text-ink-3">
									<span class="rounded-full border border-rule-strong px-2 py-0.5 font-medium text-ink-2">{EVIDENCE_LABELS[item.evidence]}</span>
									<time datetime={item.date.toISOString()}>{fmt(item.date)}</time>
									{item.draft && <span class="rounded-full bg-accent-soft px-2 py-0.5 font-medium text-accent">Draft</span>}
								</div>
								<h3 class="mt-3 font-serif text-xl font-semibold leading-snug tracking-tight text-ink group-hover:text-accent">
									{item.title}{item.external && <span class="text-ink-3" aria-label="(external link)"> ↗</span>}
								</h3>
								<p class="mt-2 text-sm leading-relaxed text-ink-2">{item.summary}</p>
								{item.release === null && item.evidence !== "essay" && <p class="mt-auto pt-3 text-xs text-ink-3">Not an analysis of a scored release.</p>}
							</a>
						))}
					</div>
				</div>
			);
		})}
	</section>
</Layout>
