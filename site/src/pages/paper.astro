---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import CiteBox from "../components/CiteBox.astro";
import { AUTHOR, REPO } from "../data/author";
import { repositoryRoot } from "../data/manuscript";
import { currentPaper, PAPER, PAPER_CITATION } from "../data/paper";
import Layout from "../layouts/Layout.astro";
import { COPY } from "../seo/copy";
import { scholarlyArticle } from "../seo/jsonld";

const workingPdfOnDisk = existsSync(
	resolve(repositoryRoot(), `site/public${PAPER.workingPdf}`),
);

const fmt = (iso: string) =>
	new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
		month: "long",
		day: "numeric",
		year: "numeric",
		timeZone: "UTC",
	});
const history = [...PAPER.versions].reverse();
// First publication is fixed in CITATION.cff. The manuscript date only
// drives `dateModified`.
const paperDate = PAPER.publishedOn;
const revisedLater = PAPER.revisedOn !== null && PAPER.revisedOn > paperDate;
const pdfUrl = workingPdfOnDisk
	? new URL(PAPER.workingPdf, Astro.site).href
	: undefined;
const articleLd = scholarlyArticle({
	headline: PAPER.title,
	description: PAPER.abstract.join(" "),
	url: new URL("/paper/", Astro.site).href,
	authorName: PAPER.author,
	datePublished: paperDate,
	dateModified: revisedLater ? PAPER.revisedOn : null,
	...(pdfUrl ? { pdfUrl } : {}),
});
---

<Layout
	title={COPY.paper.title}
	description={`${PAPER.title}. ${PAPER.status} by ${PAPER.author}.`}
	schema={[articleLd]}
>
	<Fragment slot="head">
		<meta name="citation_title" content={PAPER.title} />
		<meta name="citation_author" content={AUTHOR.citationName} />
		<meta name="citation_publication_date" content={paperDate.replaceAll("-", "/")} />
		{PAPER_CITATION.doi && <meta name="citation_doi" content={PAPER_CITATION.doi} />}
		<meta name="citation_abstract_html_url" content={new URL("/paper/", Astro.site).href} />
		{pdfUrl && <meta name="citation_pdf_url" content={pdfUrl} />}
	</Fragment>
	<article class="mx-auto max-w-4xl px-4 pt-14 sm:px-6">
		<p class="eyebrow">{PAPER.status}{currentPaper && ` · v${currentPaper.version} · ${fmt(currentPaper.date)}`}</p>
		<h1 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight sm:text-5xl">{PAPER.title}</h1>
		<p class="mt-5 text-base text-ink-2"><a class="font-medium text-ink hover:text-accent" href={AUTHOR.research}>{PAPER.author}</a></p>
		<p class="mt-2 text-sm text-ink-3">
			<span>First posted </span><time datetime={paperDate}>{fmt(paperDate)}</time>
			{PAPER.revisedOn && revisedLater && (
				<> · Manuscript updated <time datetime={PAPER.revisedOn}>{fmt(PAPER.revisedOn)}</time></>
			)}
		</p>

		<div class="mt-8 flex flex-wrap gap-3">
			{workingPdfOnDisk ? (
				<a href={PAPER.workingPdf} class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-bg hover:opacity-90">Download working PDF</a>
			) : currentPaper ? (
				<a href={currentPaper.pdf} class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-bg hover:opacity-90">Download PDF (v{currentPaper.version})</a>
			) : (
				<span class="rounded-full border border-dashed border-rule-strong px-4 py-2 text-sm text-ink-3">PDF not yet posted</span>
			)}
			<a href="/results/" class="rounded-full border border-rule-strong px-4 py-2 text-sm font-medium text-ink hover:border-ink">Results</a>
			<a href="/methods/" class="rounded-full border border-rule-strong px-4 py-2 text-sm font-medium text-ink hover:border-ink">Methods</a>
			<a href="/data/" class="rounded-full border border-rule-strong px-4 py-2 text-sm font-medium text-ink hover:border-ink">Data &amp; code</a>
			<a href="/lab/" class="rounded-full border border-rule-strong px-4 py-2 text-sm font-medium text-ink hover:border-ink">LAB audit explorer</a>
			<a href={REPO} class="rounded-full border border-rule-strong px-4 py-2 text-sm font-medium text-ink hover:border-ink">GitHub</a>
		</div>

		<section class="mt-12" aria-labelledby="abstract">
			<h2 id="abstract" class="font-serif text-2xl font-semibold tracking-tight">Abstract</h2>
			<div class="mt-4 space-y-4 text-[1.05rem] leading-relaxed text-ink-2">
				{PAPER.abstract.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<p class="mt-5 text-sm text-ink-3">
				A working paper, not peer reviewed. The title and abstract on this page are read from the manuscript, and the download is the current working PDF.
				{PAPER.abstractIsDraft &&
					" The manuscript still marks the abstract as a draft, so that passage is colored in the PDF."}
			</p>
		</section>

		{history.length > 0 && (
			<section class="mt-12" aria-labelledby="versions">
				<h2 id="versions" class="font-serif text-2xl font-semibold tracking-tight">Versions</h2>
				<ul class="mt-4 divide-y divide-rule rounded-xl border border-rule text-sm">
					{history.map((v) => (
						<li class="flex flex-wrap items-baseline justify-between gap-3 px-4 py-3">
							<span><a class="font-medium text-accent hover:underline" href={v.pdf}>v{v.version}</a> <span class="text-ink-3">· {fmt(v.date)} · analyzes {v.release}</span></span>
							{v.changes && <span class="text-ink-2">{v.changes}</span>}
						</li>
					))}
				</ul>
			</section>
		)}

		<CiteBox class="mt-12" />
	</article>
</Layout>
