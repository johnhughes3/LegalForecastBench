---
import ConfidenceChart from "../components/ConfidenceChart";
import Leaderboard from "../components/Leaderboard";
import ParetoChart from "../components/ParetoChart";
import Stat from "../components/Stat.astro";
import { AUTHOR } from "../data/author";
import { comparisonScope } from "../data/comparison";
import { formatPercent } from "../data/metrics";
import { PAPER } from "../data/paper";
import { PAPER_PROSE } from "../data/paper-prose";
import { CURRENT_RELEASE, primarySnapshot, snapshot } from "../data/results";
import Layout from "../layouts/Layout.astro";
import { COPY } from "../seo/copy";

const { cohort } = snapshot;
const n = cohort.unit_count;
const [leader] = [...primarySnapshot.models].sort(
	(a, b) => a.micro_brier - b.micro_brier,
);
const numberWords = [
	"zero",
	"one",
	"two",
	"three",
	"four",
	"five",
	"six",
	"seven",
	"eight",
	"nine",
	"ten",
	"eleven",
	"twelve",
	"thirteen",
	"fourteen",
	"fifteen",
	"sixteen",
	"seventeen",
	"eighteen",
	"nineteen",
	"twenty",
];
// The headline sentence is quoted from the paper's abstract. Refuse to build
// if the published data no longer says what that sentence says.
const headlineFacts = leader
	? [
			`${cohort.case_count} cases`,
			`${n} scored`,
			leader.display_name,
			`(${leader.micro_brier.toFixed(3)})`,
			`(${((100 * leader.correct) / n).toFixed(1)}%)`,
			`of ${numberWords[primarySnapshot.models.length] ?? primarySnapshot.models.length} models`,
		]
	: [];
const stale = headlineFacts.filter(
	(fact) => !PAPER_PROSE.headline.includes(fact),
);
if (!leader || stale.length > 0) {
	throw new Error(
		`The abstract's headline sentence no longer matches the results (${stale.join("; ")}). Update the paper or the data before publishing.`,
	);
}
const subtitle = PAPER.title.split(": ").at(-1) ?? PAPER.title;
const excerpts = [
	PAPER_PROSE.groundTruth,
	PAPER_PROSE.whyMotions,
	PAPER_PROSE.nextSteps,
];
---

<Layout title={COPY.home.title} description={COPY.home.description}>
	<section class="relative overflow-hidden border-b border-rule">
		<div class="pointer-events-none absolute inset-0 opacity-[0.5] [background-image:radial-gradient(var(--rule)_1px,transparent_1px)] [background-size:22px_22px] [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"></div>
		<div class="relative mx-auto max-w-6xl px-4 pb-14 pt-16 sm:px-6 sm:pt-24">
			<p class="eyebrow">Research benchmark · {CURRENT_RELEASE}</p>
			<h1 class="mt-4 max-w-4xl font-serif text-4xl font-medium leading-[1.08] tracking-tight text-ink sm:text-6xl">{subtitle}</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">{PAPER_PROSE.task}</p>
			<div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
				<a class="font-medium text-ink hover:text-accent" href={AUTHOR.research}>{AUTHOR.name}</a>
				<span class="text-rule-strong" aria-hidden="true">|</span>
				<a class="font-medium text-accent hover:underline" href="/paper/">{PAPER.status} →</a>
				<a class="font-medium text-accent hover:underline" href="/data/">Code &amp; data →</a>
				<a class="font-medium text-accent hover:underline" href={AUTHOR.contact}>Contact →</a>
			</div>
			<p class="mt-3 text-xs text-ink-3">In partnership with LegalQuants.</p>
			<div class="mt-12 grid grid-cols-2 gap-y-8 sm:grid-cols-4">
				<Stat value={String(cohort.case_count)} label="Federal cases" />
				<Stat value={String(n)} label="Scored units" detail="Claim × defendant forecasts" />
				<Stat value={String(primarySnapshot.models.length)} label="Model configurations" />
				<Stat value={formatPercent(cohort.dismissed_unit_count / n)} label="Dismissal base rate" detail="Units fully dismissed" />
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl scroll-mt-20 px-4 pt-16 sm:px-6" id="leaderboard">
		<p class="eyebrow">Results</p>
		<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">Forecast quality by model</h2>
		<p class="mt-4 max-w-3xl leading-relaxed text-ink-2">{PAPER_PROSE.headline}</p>
		<p class="mt-2 text-sm text-ink-3">Ranked by micro Brier. Lower is better. <span class="hidden md:inline">Click any column to re-sort.</span></p>
		<div class="mt-6">
			<Leaderboard client:load snapshot={primarySnapshot} />
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-6 sm:px-6" aria-labelledby="inference-scope">
		<div class="card space-y-2 p-5 text-sm leading-relaxed text-ink-2">
			<h2 id="inference-scope" class="font-medium text-ink">What the ordering does and does not show</h2>
			<p>{comparisonScope} Untested pairs remain untested, and a non-significant difference is not evidence that two models are equivalent. Each configuration's model page lists its version, reasoning setting, training-cutoff evidence, and cost basis.</p>
			<p>This is a public beta on {cohort.case_count} cases with one retained forecast per unit. Scores are comparable only within this cohort.</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
		<div class="grid gap-10 lg:grid-cols-[18rem_1fr]">
			<div>
				<p class="eyebrow">Cost and quality</p>
				<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">What each point of accuracy costs</h2>
				<p class="mt-4 text-sm leading-relaxed text-ink-2">Each point is one model's total standard-rate cost for the cohort against its score. Diamonds joined by the dashed line form the observed frontier: no other model is both cheaper and better.</p>
				<p class="mt-3 text-sm leading-relaxed text-ink-2">Frontier membership is descriptive and includes only models with cost evidence. A rank alone does not establish statistical significance.</p>
			</div>
			<div class="card min-w-0 p-4 sm:p-6">
				<ParetoChart client:visible snapshot={primarySnapshot} />
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
		<div class="grid gap-10 lg:grid-cols-[18rem_1fr]">
			<div>
				<p class="eyebrow">Calibration at the extremes</p>
				<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">When models are sure, are they right?</h2>
				<p class="mt-4 text-sm leading-relaxed text-ink-2">Among predictions made with at least 90% confidence either way, the hollow circle is the mean stated confidence and the filled circle is how often those predictions were right.</p>
				<p class="mt-3 text-sm leading-relaxed text-ink-2">Brier scoring squares each error, so a few confident misses can outweigh many good calls.</p>
			</div>
			<div class="card min-w-0 p-4 sm:p-6">
				<ConfidenceChart snapshot={primarySnapshot} />
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6" aria-labelledby="why">
		<p class="eyebrow">From the working paper</p>
		<h2 id="why" class="mt-2 font-serif text-3xl font-semibold tracking-tight">Why judicial outcomes</h2>
		<div class="mt-6 max-w-3xl space-y-4 border-l-2 border-rule pl-5 text-[1.02rem] leading-relaxed text-ink-2">
			{excerpts.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<a class="mt-5 inline-flex text-sm font-medium text-accent hover:underline" href="/paper/">Read the paper →</a>
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
		<div class="rounded-2xl border border-rule-strong bg-surface-2 p-6 sm:p-8 md:flex md:items-center md:justify-between md:gap-10">
			<div class="max-w-2xl">
				<h2 class="font-serif text-2xl font-semibold tracking-tight">Feedback</h2>
				<p class="mt-3 text-sm leading-relaxed text-ink-2">{PAPER_PROSE.feedback}</p>
			</div>
			<div class="mt-5 flex shrink-0 flex-wrap gap-3 md:mt-0">
				<a href={AUTHOR.contact} class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-bg hover:opacity-90">Get in touch</a>
				<a href="/paper/" class="rounded-full border border-rule-strong px-4 py-2 text-sm font-medium text-ink hover:border-ink">Read the paper</a>
			</div>
		</div>
	</section>
</Layout>
