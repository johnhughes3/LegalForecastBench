---
import ConfidenceChart from "../components/ConfidenceChart";
import FindingCard from "../components/FindingCard.astro";
import Leaderboard from "../components/Leaderboard";
import ParetoChart from "../components/ParetoChart";
import Stat from "../components/Stat.astro";
import { comparison } from "../data/comparison";
import { publishedFindings } from "../data/findings";
import { formatPercent, formatUsd, paretoFrontier } from "../data/metrics";
import { primarySnapshot, snapshot } from "../data/results";
import { supplementaryRows } from "../data/supplementary-results";
import Layout from "../layouts/Layout.astro";

const { cohort } = snapshot;
const findings = (await publishedFindings()).slice(0, 3);
const ranked = [...primarySnapshot.models].sort(
	(a, b) => a.micro_brier - b.micro_brier,
);
const leader = ranked[0];
const frontierModels = paretoFrontier(primarySnapshot, "micro_brier");
const perfect = primarySnapshot.models.filter(
	(m) => m.high_confidence.count > 0 && m.high_confidence.wrong === 0,
);
const n = primarySnapshot.cohort.unit_count;
const comparisonCurrent = comparison.available_models.filter((slug) =>
	primarySnapshot.models.some((m) => m.slug === slug),
).length;
const worstHighConfidenceRate = Math.max(
	...primarySnapshot.models
		.filter((m) => m.high_confidence.count > 0)
		.map((m) => m.high_confidence.wrong / m.high_confidence.count),
);
const takeaways: [string, string][] = leader
	? [
			[
				`${leader.display_name} leads on every metric.`,
				`Micro Brier ${leader.micro_brier.toFixed(4)}, equal-case Brier ${leader.equal_case_brier.toFixed(4)}, and ${formatPercent(leader.correct / n)} accuracy, at an estimated ${formatUsd(leader.cost.usd)} for all ${primarySnapshot.cohort.case_count} cases.`,
			],
			[
				"Cheap models hold the cost frontier.",
				`${frontierModels.map((m) => `${m.display_name} (${formatUsd(m.cost.usd)})`).join(", ")}: no other model is both cheaper and better.`,
			],
			[
				"The leaders cannot yet be separated.",
				`Among the ${comparisonCurrent} current models in the paired analysis, no difference reached significance after correcting for multiple comparisons; each beat the older GPT-4.1. The other models were not tested pairwise.`,
			],
			[
				"Confidence is where models differ most.",
				`${perfect.map((m) => m.display_name).join(" and ")} never missed a prediction made with at least 90% confidence; others missed up to ${formatPercent(worstHighConfidenceRate, 0)} of theirs.`,
			],
		]
	: [];

const jevRow = supplementaryRows.find(
	(row) => row.slug === "jev-luna-summaries",
);
const fmtDate = (iso: string) =>
	new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});
const window = `${fmtDate(cohort.decision_window.start)} – ${fmtDate(cohort.decision_window.end)}, 2026`;
---

<Layout>
	<section class="relative overflow-hidden border-b border-rule">
		<div class="pointer-events-none absolute inset-0 opacity-[0.5] [background-image:radial-gradient(var(--rule)_1px,transparent_1px)] [background-size:22px_22px] [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"></div>
		<div class="relative mx-auto max-w-6xl px-4 pb-14 pt-16 sm:px-6 sm:pt-24">
			<p class="eyebrow">Beta results · {new Date(`${snapshot.as_of}T00:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}</p>
			<h1 class="mt-4 max-w-4xl font-serif text-4xl font-medium leading-[1.08] tracking-tight text-ink sm:text-6xl">
				Can frontier models predict how federal judges will rule on motions to dismiss?
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">
				LegalForecastBench gives models the written record a judge received and asks for the probability that each challenged claim will be fully dismissed. Every forecast is scored against what the court actually did.
			</p>
			<div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
				<a class="text-accent hover:underline" href="#leaderboard">See the leaderboard ↓</a>
				<a class="text-accent hover:underline" href="/approach/">Why outcomes, not rubrics →</a>
			</div>
			<div class="mt-12 grid grid-cols-2 gap-y-8 sm:grid-cols-4">
				<Stat value={String(cohort.case_count)} label="Federal cases" detail={`Decided ${window}`} />
				<Stat value={String(cohort.unit_count)} label="Scored units" detail="Claim × defendant predictions" />
				<Stat value={String(primarySnapshot.models.length)} label="Models compared" detail={`${new Set(primarySnapshot.models.map((m) => m.provider)).size} providers · full record`} />
				<Stat value={formatPercent(cohort.dismissed_unit_count / cohort.unit_count)} label="Dismissal base rate" detail="Units fully dismissed" />
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-14 sm:px-6">
		<div class="grid gap-10 lg:grid-cols-[1fr_20rem]">
			<div>
				<h2 class="font-serif text-2xl font-semibold tracking-tight">Key takeaways</h2>
                <ol class="mt-5 space-y-4 text-[1.02rem] leading-relaxed text-ink-2">
					{takeaways.map(([title, body], i) => (
						<li class="flex gap-3">
							<span class="mt-0.5 font-serif text-accent">{i + 1}</span>
							<span><strong class="font-semibold text-ink">{title}</strong> {body}</span>
						</li>
					))}
					<li class="flex gap-3">
						<span class="mt-0.5 font-serif text-accent">{takeaways.length + 1}</span>
						<span><strong class="font-semibold text-ink">A summary pipeline fell below chance.</strong> Typesafe.ai's Jev, forecasting from case summaries, scored worse than always answering 50%, while OpenAI models given the same summaries beat the base rate. <a class="text-accent hover:underline" href="/experiments/summary-pipelines/">See the experiment →</a></span>
					</li>
				</ol>
			</div>
			<aside class="card h-fit space-y-3 p-5 text-sm text-ink-2">
				<p class="eyebrow">Read this first</p>
				<p>This is a <strong class="text-ink">public beta</strong>, and we are refining and improving the benchmark as we go. It runs on {cohort.case_count} cases, with one retained forecast per unit. Treat the ordering among the top models as provisional.</p>
				<p>Scores are comparable only within this cohort. Future versions use new cases and will not be directly comparable.</p>
				<a class="inline-flex items-center gap-1 font-medium text-accent hover:underline" href="/findings/first-release/">Read the release report →</a>
			</aside>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6" id="leaderboard">
		<div class="mb-5 flex flex-wrap items-end justify-between gap-4">
			<div>
				<p class="eyebrow">Leaderboard</p>
				<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">Forecast quality by model</h2>
			</div>
			<p class="max-w-md text-sm text-ink-3">Ranked by micro Brier, the headline metric. Lower is better. <span class="hidden md:inline">Click any column to re-sort.</span></p>
		</div>
		<Leaderboard client:load snapshot={primarySnapshot} />
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
		<div class="grid gap-10 lg:grid-cols-[18rem_1fr]">
			<div>
				<p class="eyebrow">Cost and quality</p>
				<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">What each point of accuracy costs</h2>
				<p class="mt-4 text-sm leading-relaxed text-ink-2">Each point is one model's total standard-rate cost for the cohort against its score. Diamonds joined by the dashed line form the observed frontier: no other model is both cheaper and better.</p>
				<p class="mt-3 text-sm leading-relaxed text-ink-2">Frontier membership is descriptive and includes only models with cost evidence. A rank alone does not establish statistical significance.</p>
			</div>
			<div class="card min-w-0 p-4 sm:p-6">
				<ParetoChart client:visible snapshot={primarySnapshot} />
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
		<div class="grid gap-10 lg:grid-cols-[18rem_1fr]">
			<div>
				<p class="eyebrow">Calibration at the extremes</p>
				<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">When models are sure, are they right?</h2>
				<p class="mt-4 text-sm leading-relaxed text-ink-2">Among predictions made with at least 90% confidence either way, the hollow circle is the mean stated confidence and the filled circle is how often those predictions were right.</p>
				<p class="mt-3 text-sm leading-relaxed text-ink-2">Brier scoring squares each error, so a few confident misses can outweigh many good calls.</p>
				<a class="mt-4 inline-flex text-sm font-medium text-accent hover:underline" href="/findings/confident-misses/">Why confident misses cost so much →</a>
			</div>
			<div class="card min-w-0 p-4 sm:p-6">
				<ConfidenceChart snapshot={primarySnapshot} />
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
		<a href="/experiments/summary-pipelines/" class="group grid gap-6 overflow-hidden rounded-2xl border border-rule-strong bg-surface-2 p-6 transition hover:border-accent/40 sm:p-8 md:grid-cols-[1fr_auto] md:items-center">
			<div>
				<p class="eyebrow">Experiment · Summary pipelines</p>
				<h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight group-hover:text-accent sm:text-3xl">Given the same case summaries, Jev forecast worse than a coin flip</h2>
				<p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-2">Typesafe.ai's Jev forecast from GPT-5.6 Luna summaries and scored below every naive baseline. OpenAI models reading the same summaries beat the base rate, even with reasoning off.</p>
			</div>
			<div class="flex gap-6 md:text-right">
				{jevRow && <div><p class="font-serif text-3xl tabular text-ink">{jevRow.micro_brier.toFixed(3)}</p><p class="text-xs text-ink-3">Jev micro Brier</p></div>}
				<div><p class="font-serif text-3xl tabular text-ink">0.250</p><p class="text-xs text-ink-3">Always 50%</p></div>
			</div>
		</a>
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
		<div class="mb-6 flex items-end justify-between gap-4">
			<div>
				<p class="eyebrow">Findings</p>
				<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">Reports and notes</h2>
			</div>
			<a href="/findings/" class="text-sm font-medium text-accent hover:underline">All findings →</a>
		</div>
		<div class="grid gap-4 md:grid-cols-3">
			{findings.map((entry) => <FindingCard entry={entry} />)}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
		<p class="eyebrow">How it works</p>
		<div class="mt-6 grid gap-4 md:grid-cols-4">
			{[
				["The record", "Each model receives the pre-decision docket and filings through a controlled document-tool harness. The judge's ruling is withheld."],
				["The question", "For each challenged claim against each defendant, what is the probability it is fully dismissed in the motion's first written disposition?"],
				["The answer key", "The court's actual ruling. Six configurations have documented training-data cutoffs before every decision; the other nine are qualified because cutoff evidence is unknown or overlaps the decision window."],
				["The score", "Brier score: the squared gap between forecast and outcome. It rewards calibration and discrimination, and it punishes confident errors."],
			].map(([title, body], i) => (
				<div class="card p-5">
					<p class="font-serif text-sm text-accent">0{i + 1}</p>
					<h3 class="mt-2 font-serif text-lg font-semibold">{title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-ink-2">{body}</p>
				</div>
			))}
		</div>
		<div class="mt-6 grid gap-4 md:grid-cols-[1fr_auto] md:items-center">
			<a href="/approach/" class="group card flex flex-col gap-1 p-5 transition hover:border-accent/40">
				<span class="eyebrow">Approach</span>
				<span class="font-serif text-xl font-semibold tracking-tight group-hover:text-accent">Why grade against what courts decide, not a rubric?</span>
				<span class="text-sm text-ink-2">Public litigation makes part of law checkable. Read the case for outcome-based evaluation →</span>
			</a>
			<a href="/methods/" class="inline-flex text-sm font-medium text-accent hover:underline md:px-4">Full methods →</a>
		</div>
	</section>
</Layout>
