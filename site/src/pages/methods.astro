---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

const methods = await getEntry("docs", "methods");
if (!methods)
	throw new Error("docs/METHODS.md is missing from the docs collection");
const { Content, headings } = await render(methods);
const toc = headings.filter((h) => h.depth === 2);
---

<Layout title="Methods" description="How LegalForecastBench builds its cases, runs models, and scores forecasts.">
	<section class="mx-auto max-w-6xl px-4 pt-14 sm:px-6">
		<p class="eyebrow">Methods</p>
		<h1 class="mt-3 max-w-3xl font-serif text-4xl font-medium tracking-tight sm:text-5xl">How the benchmark works</h1>
		<div class="mt-10 grid gap-4 md:grid-cols-3">
			<div class="card p-5">
				<h2 class="font-serif text-lg font-semibold">Prediction unit</h2>
				<p class="mt-2 text-sm leading-relaxed text-ink-2">One challenged claim against one defendant or defendant group. A motion attacking five claims against two defendant groups yields ten units.</p>
			</div>
			<div class="card p-5">
				<h2 class="font-serif text-lg font-semibold">Target</h2>
				<p class="mt-2 text-sm leading-relaxed text-ink-2">Whether the unit is fully dismissed in the motion's first written disposition. Dismissal with leave to amend counts as dismissal. A motion mooted by an amended complaint does not.</p>
			</div>
			<div class="card p-5">
				<h2 class="font-serif text-lg font-semibold">Brier score</h2>
				<p class="mt-2 text-sm leading-relaxed text-ink-2">(forecast − outcome)², averaged. 0 is perfect; always saying 50% scores 0.25. Micro Brier weights every unit equally; equal-case Brier weights every case equally.</p>
			</div>
		</div>
		<div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_15rem]">
			<div class="prose-lfb prose min-w-0 max-w-[46rem] break-words prose-headings:scroll-mt-24 [&_h1]:hidden">
				<p class="not-serif !mt-0 rounded-xl border border-rule bg-surface-2 px-4 py-3 text-sm text-ink-2">This section renders <a href="https://github.com/johnhughes3/LegalForecastBench/blob/main/docs/METHODS.md">docs/METHODS.md</a> from the repository, so it always matches the code.</p>
				<Content />
			</div>
			<aside class="hidden lg:block">
				<nav class="sticky top-24 text-sm" aria-label="On this page">
					<p class="font-medium text-ink">On this page</p>
					<ul class="mt-3 space-y-2 border-l border-rule">
						{toc.map((h) => <li><a class="-ml-px block border-l border-transparent pl-3 text-ink-3 hover:border-accent hover:text-ink" href={`#${h.slug}`}>{h.text}</a></li>)}
					</ul>
				</nav>
			</aside>
		</div>
	</section>
</Layout>
