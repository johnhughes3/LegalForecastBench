---
import CiteBox from "../../components/CiteBox.astro";
import { comparison } from "../../data/comparison";
import { refreshedDataDirectory } from "../../data/dataset-input";
import { PAPER_PROSE } from "../../data/paper-prose";
import { recentResults } from "../../data/recent-results";
import { releaseDescription, snapshot } from "../../data/results";
import {
	summaryComparisons,
	supplementaryRows,
} from "../../data/supplementary-results";
import Layout from "../../layouts/Layout.astro";
import { COPY } from "../../seo/copy";
import { datasetNode, softwareSourceCodeNode } from "../../seo/jsonld";

const { provenance, cohort } = snapshot;
const cell = "px-4 py-3 align-top";
const link = "text-accent hover:underline";
const nameOf = (slug: string) =>
	snapshot.models.find((m) => m.slug === slug)?.display_name ?? slug;
const summaryName = (slug: string) => {
	const row = supplementaryRows.find((r) => r.slug === slug);
	return row
		? `${row.display_name} (reasoning ${row.reasoning_label.toLowerCase()})`
		: slug;
};
const repo = "https://github.com/johnhughes3/LegalForecastBench";
const datasetLd = datasetNode({
	name: "LegalForecastBench results",
	description: releaseDescription(),
	url: new URL("/data/", Astro.site).href,
	temporalCoverage: `${cohort.decision_window.start}/${cohort.decision_window.end}`,
	version: provenance.release,
	dateModified: snapshot.as_of,
	downloads: [
		{ name: "Ranked results", path: "/data/current.json" },
		{
			name: "Paired significance analysis",
			path: "/data/significance/comparison.json",
		},
		{ name: "Run and release provenance", path: "/data/sources.json" },
		{ name: "Cost evidence", path: "/data/costs.json" },
	].map(({ name, path }) => ({
		name,
		contentUrl: new URL(path, Astro.site).href,
	})),
});
---

<Layout title={COPY.data.title} description={COPY.data.description} schema={[datasetLd, softwareSourceCodeNode()]}>
	<section class="mx-auto max-w-5xl px-4 pt-14 sm:px-6">
		<p class="eyebrow">Data &amp; code</p>
		<h1 class="mt-3 font-serif text-4xl font-medium tracking-tight sm:text-5xl">Data and code</h1>
		<p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink-2">{PAPER_PROSE.access}</p>
		<p class="mt-3 text-sm text-ink-2"><a class={link} href={repo}>Repository</a> · <a class={link} href="https://www.courtlistener.com/">CourtListener</a> · <a class={link} href={`${repo}/issues/new`}>Report an error</a></p>
		{refreshedDataDirectory && <p class="mt-3 text-sm text-ink-2">This refreshed cohort excludes withdrawn cases. <a class={link} href="/data/historical-aggregates.json" download>Superseded aggregate provenance</a>.</p>}

		<h2 id="downloads" class="mt-12 font-serif text-2xl font-semibold tracking-tight">Downloads</h2>
		<div class="mt-4 overflow-x-auto rounded-xl border border-rule">
			<table class="w-full text-left text-sm">
				<thead class="border-b border-rule bg-surface-2/50 text-xs text-ink-3">
					<tr><th scope="col" class={cell}>File</th><th scope="col" class={cell}>Contents</th></tr>
				</thead>
				<tbody class="divide-y divide-rule text-ink-2">
					<tr><td class={cell}><a class={link} href="/data/current.json" download>Leaderboard</a></td><td class={cell}>Each model's scores, training cutoff, eligibility and cost</td></tr>
					<tr id="significance"><td class={cell}>Forecasts</td><td class={cell}>
						One row per claim–defendant unit: case ID, unit ID, the model's probability of dismissal, and the outcome
						<ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">{comparison.available_models.map((slug) => <li><a class={link} href={`/data/significance/${slug}.jsonl`} download>{nameOf(slug)}</a></li>)}</ul>
						<p class="mt-2 text-xs text-ink-3">Unit-level forecasts were not kept for {comparison.missing_models.map(nameOf).join(", ")}.</p>
					</td></tr>
					<tr><td class={cell}><a class={link} href="/data/significance/comparison.json" download>Significance</a></td><td class={cell}>Paired bootstrap intervals for every pair of models above (<a class={link} href="/data/significance/inputs.json" download>inputs</a>)</td></tr>
					<tr id="exports"><td class={cell}>Full exports</td><td class={cell}>
						Complete scored output for each run, with cost accounting and its GitHub Actions runs
						<ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">{recentResults.map(({ source }) => <li><a class={link} href={`/data/exports/${source.slug}.json`} download>{nameOf(source.slug)}</a></li>)}</ul>
					</td></tr>
					<tr id="supplementary"><td class={cell}><a class={link} href="/data/summary-comparison/catalog.json" download>Jev experiment</a></td><td class={cell}>
						Forecasts from case summaries, kept separate from the leaderboard
						<ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
							{summaryComparisons.map(({ source }) => <li><a class={link} href={`/data/exports/${source.slug}.json`} download>{summaryName(source.slug)}</a></li>)}
							<li><a class={link} href="/data/significance/summary/comparison.json" download>significance</a></li>
						</ul>
					</td></tr>
				</tbody>
			</table>
		</div>

		<div class="mt-12 grid gap-10 md:grid-cols-2">
			<div>
				<h2 class="font-serif text-2xl font-semibold tracking-tight">Reproduce</h2>
				<ul class="mt-3 space-y-1.5 text-sm">
					<li><a class={link} href={`${repo}/blob/main/docs/METHODS.md`}>Methods</a></li>
					<li><a class={link} href={`${repo}/blob/main/docs/reproduce-or-audit.md`}>Reproduce or audit a result</a></li>
					<li><a class={link} href={`${repo}/blob/main/docs/site-data.md`}>Data format</a></li>
				</ul>
			</div>
			<div>
				<h2 class="font-serif text-2xl font-semibold tracking-tight">License</h2>
				<p class="mt-3 text-sm text-ink-2">The files above: <a class={link} href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Code: Apache 2.0. Court filings are public records and are not licensed here.</p>
			</div>
		</div>

		<CiteBox class="mt-12" />
	</section>
</Layout>
