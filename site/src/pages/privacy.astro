---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Privacy policy" description="How LegalForecastBench uses aggregate website analytics and how to turn it off.">
	<article class="prose prose-slate mx-auto max-w-3xl px-4 py-14 sm:px-6">
		<h1>Privacy policy</h1>
		<p>This site is hosted by Vercel and uses <a href="https://vercel.com/docs/analytics/privacy-policy">Vercel’s standard analytics tools</a> to measure user traffic. Vercel provides us with aggregate statistics such as page views, clicks, referring websites, and browser and device types. We do not use this information to identify individual visitors or track them across websites. If you voluntarily provide information to us—for example, by sending an email—we receive the information you choose to share.</p>
		<h2>Your choice</h2>
		<p>You can turn off analytics below. We also suppress analytics when your browser sends Do Not Track or Global Privacy Control. The choice below is stored only in this browser, on this site, as an on/off preference. Set it separately on the personal site if you visit both.</p>
		<button id="analytics-choice" type="button" class="rounded border border-line px-4 py-2" hidden>Turn off analytics</button>
		<p id="analytics-status" role="status"></p>
		<noscript><p>Analytics is not loaded when JavaScript is disabled.</p></noscript>
	</article>
</Layout>

<script>
	const button = document.querySelector<HTMLButtonElement>("#analytics-choice");
	const status = document.querySelector<HTMLElement>("#analytics-status");
	if (button && status) {
		const signal = navigator.doNotTrack === "1" || Reflect.get(navigator, "globalPrivacyControl") === true;
		const render = (): void => {
			try {
				if (Reflect.get(window, "analyticsOptOutFailed") === true) throw new Error("Preferences unavailable");
				const disabled = localStorage.getItem("analytics-opt-out") === "1";
				button.hidden = signal;
				button.textContent = disabled ? "Allow basic analytics" : "Turn off analytics";
				status.textContent = signal ? "Analytics is off because of your browser’s privacy preference." : disabled ? "Analytics is off in this browser on this site." : "Basic analytics is on. You can turn it off here.";
			} catch {
				Reflect.set(window, "analyticsOptOutFailed", true);
				button.hidden = true;
				status.textContent = "Analytics is off for this page because browser preferences are unavailable.";
			}
		};
		button.addEventListener("click", () => {
			try {
				if (localStorage.getItem("analytics-opt-out") === "1") localStorage.removeItem("analytics-opt-out");
				else localStorage.setItem("analytics-opt-out", "1");
			} catch { Reflect.set(window, "analyticsOptOutFailed", true); }
			render();
		});
		render();
	}
</script>
