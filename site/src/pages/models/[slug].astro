---
import type { GetStaticPaths } from "astro";
import ConfidenceChart from "../../components/ConfidenceChart";
import EligibilityBadge from "../../components/EligibilityBadge";
import ParetoChart from "../../components/ParetoChart";
import Tip from "../../components/Tip";
import { comparison } from "../../data/comparison";
import { EXPLAIN } from "../../data/explanations";
import {
	formatPercent,
	formatUsd,
	METRICS,
	paretoFrontier,
	ranks,
} from "../../data/metrics";
import { recentResults } from "../../data/recent-results";
import { primarySnapshot, REFERENCE_SLUGS, snapshot } from "../../data/results";
import type { Metric, SnapshotModel } from "../../data/snapshot";
import Layout from "../../layouts/Layout.astro";
import { modelTitle } from "../../seo/titles";

export const getStaticPaths = (() =>
	snapshot.models.map((model) => ({
		params: { slug: model.slug },
		props: { model },
	}))) satisfies GetStaticPaths;

const { model } = Astro.props as { model: SnapshotModel };
const source = recentResults.find(
	({ source }) => source.slug === model.slug,
)?.source;
const n = snapshot.cohort.unit_count;
const isReference = REFERENCE_SLUGS.has(model.slug);
const ranked = isReference ? snapshot : primarySnapshot;
const total = primarySnapshot.models.length;
const metrics: Metric[] = ["micro_brier", "equal_case_brier", "accuracy"];
const cards = metrics.map((metric) => {
	const value = metric === "accuracy" ? model.correct / n : model[metric];
	return {
		metric,
		spec: METRICS[metric],
		value,
		rank: ranks(ranked, metric).get(model.slug) ?? total,
		frontier:
			!isReference &&
			paretoFrontier(primarySnapshot, metric).some(
				(m) => m.slug === model.slug,
			),
	};
});
const hc = model.high_confidence;
const includedInComparison = comparison.available_models.includes(model.slug);
const sig = snapshot.significant_pairs
	.filter((p) => p.better === model.slug || p.worse === model.slug)
	.map((p) => {
		const other = snapshot.models.find(
			(m) => m.slug === (p.better === model.slug ? p.worse : p.better),
		);
		return { ...p, other, won: p.better === model.slug };
	});
// Group pairs that share a direction and metric set into one sentence.
const listMetrics = (labels: string[]) =>
	labels.length <= 2
		? labels.join(" and ")
		: `${labels.slice(0, -1).join(", ")}, and ${labels.at(-1)}`;
const byOther = new Map<
	string,
	{ won: boolean; other: SnapshotModel; metrics: string[] }
>();
for (const pair of sig) {
	if (!pair.other) continue;
	const key = `${pair.won}:${pair.other.slug}`;
	const entry = byOther.get(key) ?? {
		won: pair.won,
		other: pair.other,
		metrics: [],
	};
	entry.metrics.push(METRICS[pair.metric].label);
	byOther.set(key, entry);
}
const sigGroupMap = new Map<
	string,
	{ won: boolean; metrics: string; others: SnapshotModel[] }
>();
for (const entry of byOther.values()) {
	const metrics = listMetrics(entry.metrics);
	const key = `${entry.won}:${metrics}`;
	const group = sigGroupMap.get(key) ?? { won: entry.won, metrics, others: [] };
	group.others.push(entry.other);
	sigGroupMap.set(key, group);
}
const sigGroups = [...sigGroupMap.values()];
const facts: [string, string][] = [
	["Model key", model.model_key],
	["Access", model.access],
	["Reasoning", model.reasoning],
	[
		"Public release",
		new Date(`${model.release_date}T00:00:00Z`).toLocaleDateString("en-US", {
			month: "long",
			day: "numeric",
			year: "numeric",
			timeZone: "UTC",
		}),
	],
	["Training cutoff", model.training_cutoff ?? "Not disclosed"],
	["Harness", "Full-document agentic (controlled document tools)"],
];
---

<Layout
	title={modelTitle(model.display_name)}
	image={`/og/models/${model.slug}.png`}
	description={`${model.display_name} on LegalForecastBench: micro Brier ${model.micro_brier.toFixed(4)} across ${n} units.`}
>
	<section class="border-b border-rule">
		<div class="mx-auto max-w-6xl px-4 pb-10 pt-12 sm:px-6">
			<a href="/#leaderboard" class="text-sm text-ink-3 hover:text-ink">← Leaderboard</a>
			<div class="mt-6 flex flex-wrap items-center gap-3">
				<p class="eyebrow">{model.provider}</p>
				<EligibilityBadge eligibility={model.eligibility} reason={model.eligibility_reason} side="bottom" align="start" />
			</div>
			<h1 class="mt-3 font-serif text-4xl font-medium tracking-tight sm:text-5xl">{model.display_name}</h1>
			<div class="mt-10 grid gap-4 sm:grid-cols-3">
				{
					cards.map((c) => (
						<div class="card p-5">
							<p class="text-sm text-ink-3">
								{c.spec.label}
								{c.metric === "micro_brier" && (
									<Tip tip={EXPLAIN.headline} className="ml-1.5 align-middle"><span class="rounded-full bg-surface-2 px-2 py-0.5 text-[11px] underline decoration-dotted underline-offset-2">Headline</span></Tip>
								)}
							</p>
							<p class="mt-2 font-serif text-4xl font-medium tabular">{c.spec.format(c.value)}</p>
							<p class="mt-2 text-sm text-ink-2">
								{isReference ? "Reference model · not ranked" : `Rank ${c.rank} of ${total}`}
								{c.frontier && <span class="text-series-1"> · <Tip tip={EXPLAIN.frontier}><span class="underline decoration-dotted underline-offset-2">on the cost frontier</span></Tip></span>}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="mx-auto grid max-w-6xl gap-10 px-4 pt-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
		<div class="min-w-0 space-y-12">
			{isReference ? (
				<div class="card p-6">
					<h2 class="font-serif text-2xl font-semibold tracking-tight">An older reference model</h2>
					<p class="mt-3 leading-relaxed text-ink-2">
						{model.display_name} is an older, non-reasoning model run on the same full record and harness. It is kept as a reference rather than ranked with current models. It mostly answered 0% or 100%, and its forecasts show no ranking signal.
					</p>
					
				</div>
			) : (
				<Fragment>
			<div>
				<h2 class="font-serif text-2xl font-semibold tracking-tight">Cost and quality</h2>
				<div class="card mt-4 p-4 sm:p-6">
					<ParetoChart client:visible snapshot={primarySnapshot} highlight={model.slug} />
				</div>
			</div>
			<div>
				<h2 class="font-serif text-2xl font-semibold tracking-tight">High-confidence forecasts</h2>
				<p class="mt-2 text-ink-2">
					{hc.count} of {n} predictions ({formatPercent(hc.count / n)}) were at least 90% confident either way.
					{hc.wrong === 0 ? " None were wrong." : ` ${hc.wrong} were wrong, an error rate of ${formatPercent(hc.wrong / hc.count)}.`}
					{hc.mean_confidence !== null && ` Mean stated confidence in that subset was ${formatPercent(hc.mean_confidence)}.`}
				</p>
				<div class="card mt-4 p-4 sm:p-6">
					<ConfidenceChart snapshot={primarySnapshot} highlight={model.slug} />
				</div>
			</div>
				</Fragment>
			)}
            <div>
                <h2 class="font-serif text-2xl font-semibold tracking-tight">Statistical comparison coverage</h2>
                <p class="mt-2 text-ink-2">{includedInComparison ? "Included in the paired significance analysis." : "Not included in the paired significance analysis, so its differences from other models were not tested."}</p>
                <a class="mt-2 inline-flex text-sm text-accent hover:underline" href="/data/#significance">Analysis and reproducible inputs →</a>
            </div>
			{
				sig.length > 0 && (
					<div>
						<h2 class="font-serif text-2xl font-semibold tracking-tight">Statistically distinguishable differences</h2>
						<ul class="mt-3 space-y-2 text-ink-2">
							{sigGroups.map((g) => (
								<li>
									{g.won ? "Better" : "Worse"} than{" "}
									{g.others.map((o, i) => (
										<Fragment>
											{i > 0 && (i === g.others.length - 1 ? (g.others.length > 2 ? ", and " : " and ") : ", ")}
											<a class="text-accent hover:underline" href={`/models/${o.slug}/`}>{o.display_name}</a>
										</Fragment>
									))}{" "}
									on {g.metrics}.
								</li>
							))}
						</ul>
<a class="text-sm text-accent hover:underline" href="/data/#significance">Comparison methodology →</a>
					</div>
				)
			}
		</div>

		<aside class="space-y-4">
			<div class="card p-5">
				<h2 class="text-sm font-semibold text-ink">Configuration</h2>
				<dl class="mt-3 space-y-3 text-sm">
					{
						facts.map(([k, v]) => (
							<div>
								<dt class="text-xs text-ink-3">{k}</dt>
								<dd class="mt-0.5 break-words text-ink-2">{v}</dd>
							</div>
						))
					}
				</dl>
			</div>
			<div class="card p-5 text-sm">
				<h2 class="font-semibold text-ink">Eligibility</h2>
				<p class="mt-2 text-ink-2">{model.eligibility_reason}</p>
				<p class="mt-2 text-xs text-ink-3">
					Eligible means the provider-reported training or knowledge cutoff falls before the first scored decision ({
						snapshot.cohort.decision_window.start
					} to {snapshot.cohort.decision_window.end}). A provider cutoff is evidence, not proof of what the model saw.
				</p>
			</div>
			<div class="card p-5 text-sm">
				<h2 class="font-semibold text-ink">Cost</h2>
				<p class="mt-2 font-serif text-2xl tabular">{formatUsd(model.cost.usd)}</p>
				<p class="text-xs text-ink-3">
					{model.cost.basis === "unavailable" ? "Unavailable" : model.cost.basis === "estimated" ? "Estimated" : "Standard-rate"} cost for {snapshot.cohort.case_count} cases ·{" "}
					{formatUsd(model.cost.usd === null ? null : model.cost.usd / snapshot.cohort.case_count)} per case
				</p>
				{model.cost.note && <p class="mt-3 text-xs leading-relaxed text-secondary">{model.cost.note}</p>}
				<a class="mt-2 inline-flex text-xs text-accent hover:underline" href="/data/#costs">Cost methodology →</a>
			</div>
			<div class="card p-5 text-sm">
				<h2 class="font-semibold text-ink">Run</h2>
				<p class="mt-2 text-ink-2">
					<a
						class="text-accent hover:underline"
						href={`https://github.com/johnhughes3/LegalForecastBench/actions/runs/${model.github_run_id}`}
						>GitHub Actions run {model.github_run_id}</a
					>
				</p>
                {source && <p class="mt-2"><a class="text-accent hover:underline" href={`https://github.com/johnhughes3/LegalForecastBench/actions/runs/${source.scoring_run}`}>Scoring run {source.scoring_run}</a></p>}
                {source && <p class="mt-2"><a class="text-accent hover:underline" href={`/data/exports/${source.slug}.json`} download>Download scored source export</a></p>}
			</div>
		</aside>
	</section>
</Layout>
