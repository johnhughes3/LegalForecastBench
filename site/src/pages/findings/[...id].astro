---
import { type CollectionEntry, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import { publishedFindings } from "../../data/findings";
import { snapshot } from "../../data/results";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = (async () =>
	(await publishedFindings()).map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}))) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: CollectionEntry<"findings"> };
const { Content, headings } = await render(entry);
const date = entry.data.date.toLocaleDateString("en-US", {
	month: "long",
	day: "numeric",
	year: "numeric",
	timeZone: "UTC",
});
const kindLabel = { report: "Report", note: "Note", critique: "Critique" }[
	entry.data.kind
];
const toc = headings.filter((h) => h.depth === 2);
const models = snapshot.models.filter((m) =>
	entry.data.models.includes(m.slug),
);
const articleLd = {
	"@context": "https://schema.org",
	"@type": "ScholarlyArticle",
	headline: entry.data.title,
	description: entry.data.summary,
	datePublished: entry.data.date.toISOString().slice(0, 10),
	author: { "@type": "Person", name: entry.data.author },
	url: new URL(`/findings/${entry.id}/`, Astro.site).toString(),
	isPartOf: {
		"@type": "WebSite",
		name: "LegalForecastBench",
		url: Astro.site?.toString(),
	},
};
---

<Layout title={entry.data.title} description={entry.data.summary} image={`/og/findings/${entry.id}.png`}>
	<script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
	<article class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
		<a href="/findings/" class="text-sm text-ink-3 hover:text-ink">← Findings</a>
		<header class="mt-8 max-w-3xl">
			<p class="eyebrow">{kindLabel}</p>
			<h1 class="mt-3 font-serif text-4xl font-medium leading-tight tracking-tight sm:text-5xl">{entry.data.title}</h1>
			<p class="mt-5 text-lg leading-relaxed text-ink-2">{entry.data.summary}</p>
			<p class="mt-5 text-sm text-ink-3">
				{entry.data.author} · <time datetime={entry.data.date.toISOString()}>{date}</time>
			</p>
		</header>
		{
			entry.data.draft && (
				<div class="mt-8 max-w-3xl rounded-xl border border-accent/30 bg-accent-soft px-4 py-3 text-sm text-ink">
					<strong>Draft.</strong> Visible in previews only. It is not part of the production site until its open items are
					resolved.
				</div>
			)
		}
		<div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_15rem]">
			<div class="prose-lfb prose min-w-0 max-w-[46rem] prose-headings:scroll-mt-24 prose-a:font-normal">
				<Content />
			</div>
			<aside class="hidden lg:block">
				<div class="sticky top-24 space-y-8 text-sm">
					{
						toc.length > 1 && (
							<nav aria-label="On this page">
								<p class="font-medium text-ink">On this page</p>
								<ul class="mt-3 space-y-2 border-l border-rule">
									{toc.map((h) => (
										<li>
											<a
												class="-ml-px block border-l border-transparent pl-3 text-ink-3 hover:border-accent hover:text-ink"
												href={`#${h.slug}`}
											>
												{h.text}
											</a>
										</li>
									))}
								</ul>
							</nav>
						)
					}
					{
						models.length > 0 && (
							<div>
								<p class="font-medium text-ink">Models discussed</p>
								<ul class="mt-3 space-y-1.5">
									{models.map((m) => (
										<li>
											<a class="text-ink-3 hover:text-accent" href={`/models/${m.slug}/`}>
												{m.display_name}
											</a>
										</li>
									))}
								</ul>
							</div>
						)
					}
				</div>
			</aside>
		</div>
	</article>
</Layout>
