{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "LegalForecastBench aggregate results snapshot",
	"description": "Hand-transcribed aggregate results for a published comparison.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"snapshot_id",
		"title",
		"status",
		"as_of",
		"provenance",
		"cohort",
		"significant_pairs",
		"models"
	],
	"properties": {
		"snapshot_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
		"title": { "type": "string" },
		"status": { "enum": ["beta", "official"] },
		"as_of": { "type": "string", "format": "date" },
		"provenance": {
			"type": "object",
			"additionalProperties": false,
			"required": ["release", "release_digest", "method"],
			"properties": {
				"release": { "type": "string" },
				"release_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"method": { "type": "string" }
			}
		},
		"cohort": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"case_count",
				"unit_count",
				"dismissed_unit_count",
				"decision_window",
				"constant_forecast_micro_brier",
				"majority_class_accuracy",
				"bootstrap"
			],
			"properties": {
				"case_count": { "type": "integer", "minimum": 1 },
				"unit_count": { "type": "integer", "minimum": 1 },
				"dismissed_unit_count": { "type": "integer", "minimum": 0 },
				"decision_window": {
					"type": "object",
					"additionalProperties": false,
					"required": ["start", "end"],
					"properties": {
						"start": { "type": "string", "format": "date" },
						"end": { "type": "string", "format": "date" }
					}
				},
				"constant_forecast_micro_brier": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"majority_class_accuracy": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"bootstrap": {
					"type": "object",
					"additionalProperties": false,
					"required": ["method", "replicates", "correction", "caveat"],
					"properties": {
						"method": { "type": "string" },
						"replicates": { "type": "integer", "minimum": 1 },
						"correction": { "type": "string" },
						"caveat": { "type": "string" }
					}
				}
			}
		},
		"significant_pairs": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["better", "worse", "metric"],
				"properties": {
					"better": { "type": "string" },
					"worse": { "type": "string" },
					"metric": { "enum": ["micro_brier", "equal_case_brier", "accuracy"] }
				}
			}
		},
		"models": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"slug",
					"display_name",
					"provider",
					"model_key",
					"access",
					"reasoning",
					"release_date",
					"training_cutoff",
					"eligibility",
					"eligibility_reason",
					"github_run_id",
					"micro_brier",
					"equal_case_brier",
					"correct",
					"high_confidence",
					"cost"
				],
				"properties": {
					"slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
					"display_name": { "type": "string" },
					"provider": { "type": "string" },
					"model_key": { "type": "string" },
					"access": { "type": "string" },
					"reasoning": { "type": "string" },
					"release_date": { "type": "string", "format": "date" },
					"training_cutoff": { "type": ["string", "null"] },
					"eligibility": { "enum": ["eligible", "qualified", "unknown"] },
					"eligibility_reason": { "type": "string" },
					"github_run_id": { "type": "string", "pattern": "^[0-9]+$" },
					"micro_brier": { "type": "number", "minimum": 0, "maximum": 1 },
					"equal_case_brier": { "type": "number", "minimum": 0, "maximum": 1 },
					"correct": { "type": "integer", "minimum": 0 },
					"high_confidence": {
						"type": "object",
						"additionalProperties": false,
						"required": ["count", "wrong", "mean_confidence"],
						"properties": {
							"count": { "type": "integer", "minimum": 0 },
							"wrong": { "type": "integer", "minimum": 0 },
							"mean_confidence": {
								"type": ["number", "null"],
								"minimum": 0.5,
								"maximum": 1
							}
						}
					},
					"cost": {
						"type": "object",
						"additionalProperties": false,
						"required": ["usd", "basis", "note"],
						"properties": {
							"usd": { "type": ["number", "null"], "minimum": 0 },
							"basis": {
								"enum": ["standard_rate", "estimated", "unavailable"]
							},
							"note": { "type": ["string", "null"] }
						}
					}
				}
			}
		}
	}
}
