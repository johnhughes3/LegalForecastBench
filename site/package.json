{
	"name": "@legalforecastbench/site",
	"private": true,
	"type": "module",
	"scripts": {
		"brand:generate": "tsx scripts/generate-brand.tsx",
		"check": "pnpm lint && pnpm typecheck && pnpm contract:check && pnpm test",
		"lint": "biome check .",
		"typecheck": "astro check && tsc --noEmit",
		"contract:generate": "tsx scripts/generate-contract.ts",
		"contract:check": "tsx scripts/generate-contract.ts --check",
		"contract:validate": "tsx scripts/validate-export.ts",
		"test": "tsx --test src/data/*.test.ts src/seo/*.test.ts",
		"test:browser": "tsx --test scripts/*.test.ts",
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview"
	},
	"dependencies": {
		"@astrojs/mdx": "8.0.2",
		"@astrojs/react": "7.0.0",
		"@astrojs/sitemap": "3.7.4",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/newsreader": "5.3.0",
		"@fontsource/inter": "5.3.0",
		"@fontsource/newsreader": "5.3.0",
		"@resvg/resvg-js": "2.6.2",
		"@tailwindcss/vite": "4.3.3",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"astro": "7.3.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"satori": "0.33.5",
		"tailwindcss": "4.3.3",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@biomejs/biome": "2.5.14",
		"@tailwindcss/typography": "0.5.20",
		"@types/node": "24.13.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"json-schema-to-typescript": "16.0.0",
		"playwright": "1.63.0",
		"tsx": "4.23.15",
		"typescript": "6.0.3"
	}
}
