{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"noEmit": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"types": ["node"]
	},
	"include": [".astro/types.d.ts", "src/**/*", "scripts/**/*.ts"],
	"exclude": ["dist"]
}
