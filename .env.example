# Copy to .env for local live smoke tests. Do not commit real secrets.
#
# Nothing here is needed for the default developer workflow. The fixture
# workflow (`legalforecast fixture e2e`), the multi-harness no-network smokes,
# and `scripts/release_check.py` all run without credentials. These variables
# are read only by live acquisition and live evaluation paths.

# --- CourtListener / RECAP -------------------------------------------------
# CourtListener REST is the production final authority for paid document gaps.
# RECAP_API_TOKEN falls back to COURTLISTENER_API_TOKEN when unset.
COURTLISTENER_API_TOKEN=
COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4
COURTLISTENER_TIMEOUT_SECONDS=30
RECAP_API_TOKEN=
RECAP_BASE_URL=https://www.courtlistener.com/api/rest/v4
RECAP_TIMEOUT_SECONDS=30

# --- case.dev --------------------------------------------------------------
# Free lookup/search and metadata enrichment only. Legacy case.dev paid
# purchase commands are disabled for live use.
CASE_DEV_API_KEY=
CASE_DEV_BASE_URL=https://api.case.dev
CASE_DEV_LIVE_TESTS=0
CASE_DEV_RATE_LIMIT_PER_MINUTE=
CASE_DEV_TIMEOUT_SECONDS=30
CASE_DEV_ESTIMATED_COST_PER_REQUEST_USD=

# --- Firecrawl -------------------------------------------------------------
# Cycle-budgeted CourtListener screening route.
FIRECRAWL_API_KEY=

# --- Model providers -------------------------------------------------------
# Live evaluation solvers. Official runs execute without network access; these
# are used by the provider-facing run paths only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Document parsing ------------------------------------------------------
# Required before spawning the Mistral markdown parser subprocess.
MISTRAL_API_KEY=
