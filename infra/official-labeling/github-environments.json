      "provider": "google",
      "aws_oidc_subject": "repo:johnhughes3/LegalForecastBench:environment:legalforecastbench-official-labeling-google-label",
      "secrets": ["BATON_AGE_IDENTITY", "PROVIDER_API_KEY"],
      "variables": ["LFB_AWS_REGION", "LFB_BATON_AGE_RECIPIENT", "LFB_GITHUB_LABELING_ROLE_ARN", "LFB_PROVIDER_ACCOUNT_ALIAS", "LFB_PROVIDER_AUTHORITY_TABLE"]
