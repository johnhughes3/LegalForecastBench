# Same locked Python import closure as the canonical gateway image; no credentials.
FROM ghcr.io/astral-sh/uv:0.12.0@sha256:606e70c71c852d03f611b1e56a195d08648507018a7057fab82c4974c4eae105 AS uv
FROM python:3.14.2-alpine3.23@sha256:31da4cb527055e4e3d7e9e006dffe9329f84ebea79eaca0a1f1c27ce61e40ca5
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /opt/legalforecast
ENV UV_PROJECT_ENVIRONMENT=/opt/legalforecast/.venv UV_LINK_MODE=copy
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --locked --no-dev --no-install-project
COPY legalforecast ./legalforecast
RUN uv sync --locked --no-dev --no-editable
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
USER 65532:65532
ENTRYPOINT ["/opt/legalforecast/.venv/bin/python", "-I", "-m", "legalforecast.multiharness.task_worker"]
