FROM ghcr.io/astral-sh/uv:0.12.0@sha256:606e70c71c852d03f611b1e56a195d08648507018a7057fab82c4974c4eae105 AS uv
FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /opt/legalforecast
ENV UV_PROJECT_ENVIRONMENT=/opt/legalforecast/.venv \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install --no-install-recommends --yes python3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --locked --no-dev --no-install-project --python 3.14
COPY legalforecast ./legalforecast
RUN uv sync --locked --no-dev --python 3.14
COPY examples/adapters/openclaw-pinned/package.json examples/adapters/openclaw-pinned/pnpm-lock.yaml examples/adapters/openclaw-pinned/pnpm-workspace.yaml ./examples/adapters/openclaw-pinned/
RUN corepack enable pnpm && corepack prepare pnpm@10.33.0 --activate && pnpm --dir examples/adapters/openclaw-pinned install --frozen-lockfile
# Complete the pinned distribution's own deferred lifecycle before the runtime
# filesystem becomes read-only; this probe has no network or provider access.
RUN --network=none node examples/adapters/openclaw-pinned/node_modules/openclaw/openclaw.mjs --version
COPY examples/adapters/openclaw-pinned/adapter-manifest.json ./examples/adapters/openclaw-pinned/
COPY infra/openclaw-runtime/launcher /opt/legalforecast/libexec/openclaw
RUN chmod 0755 /opt/legalforecast/libexec/openclaw && mkdir -p /workspace /home/harness
WORKDIR /workspace
USER 65532:65532
ENTRYPOINT ["/opt/legalforecast/libexec/openclaw"]
