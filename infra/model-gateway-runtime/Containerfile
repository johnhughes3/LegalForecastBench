# Provider-free runtime for the model gateway sidecar.
#
# The gateway process is started by the outer container harness.  This image
# carries the locked LegalForecastBench import closure and the AWS CLI used by
# the protected spend controller; it contains no provider credential and does
# not make a provider request during build or startup.

FROM ghcr.io/astral-sh/uv:0.12.0@sha256:606e70c71c852d03f611b1e56a195d08648507018a7057fab82c4974c4eae105 AS uv

FROM python:3.14.2-alpine3.23@sha256:31da4cb527055e4e3d7e9e006dffe9329f84ebea79eaca0a1f1c27ce61e40ca5 AS build

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /opt/legalforecast
ENV UV_PROJECT_ENVIRONMENT=/opt/legalforecast/.venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Install the locked third-party environment before copying source so source
# edits do not invalidate the dependency layer.  The second sync installs the
# project itself as a non-editable wheel into the same environment.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY README.md LICENSE ./
COPY legalforecast ./legalforecast
RUN uv sync --locked --no-dev --no-editable

FROM python:3.14.2-alpine3.23@sha256:31da4cb527055e4e3d7e9e006dffe9329f84ebea79eaca0a1f1c27ce61e40ca5 AS runtime

# Pin the Alpine package version as well as the base image.  The CLI is used
# by the protected DynamoDB spend authority; no AWS request is made here.
RUN apk add --no-cache \
      aws-cli=2.32.7-r0 \
      ca-certificates \
    && update-ca-certificates

COPY --from=build /opt/legalforecast/.venv /opt/legalforecast/.venv

ENV PATH="/opt/legalforecast/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp
WORKDIR /opt/legalforecast

# The harness may override this user when it bind-mounts its per-run package;
# the image default remains unprivileged for direct smoke probes.
USER 65532:65532
