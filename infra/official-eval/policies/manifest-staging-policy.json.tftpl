{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DecryptArtifactObjects",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "${artifacts_kms_key_arn}"
    },
    {
      "Sid": "GenerateArtifactDataKeys",
      "Effect": "Allow",
      "Action": "kms:GenerateDataKey",
      "Resource": "${artifacts_kms_key_arn}"
    },
    {
      "Sid": "ReadManifestRunArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${results_bucket_arn}/cycle-1/manifest-runs/*"
    },
    {
      "Sid": "CreateManifestRunArtifacts",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "${results_bucket_arn}/cycle-1/manifest-runs/*",
      "Condition": {
        "Null": {
          "s3:if-none-match": "false"
        }
      }
    },
    {
      "Sid": "ReadModelPackets",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${packet_bucket_arn}/model-packets/*"
    },
    {
      "Sid": "CreateModelPackets",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "${packet_bucket_arn}/model-packets/*",
      "Condition": {
        "Null": {
          "s3:if-none-match": "false"
        }
      }
    }
  ]
}
