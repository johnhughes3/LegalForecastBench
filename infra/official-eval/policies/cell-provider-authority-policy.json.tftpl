{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExactProviderAuthorityDataPlane",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ConditionCheckItem",
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "${provider_authority_table_arn}"
    }
  ]
}
