{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DecryptForecastInputs",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "${artifacts_kms_key_arn}"
    },
    {
      "Sid": "ReadLockedManifestObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${results_bucket_arn}/manifests/*"
    },
    {
      "Sid": "ListLockedManifestObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${results_bucket_arn}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "manifests/*"
        }
      }
    },
    {
      "Sid": "ReadManifestRunForecastObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${results_bucket_arn}/cycle-1/manifest-runs/*"
    },
    {
      "Sid": "ListManifestRunForecastObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${results_bucket_arn}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "cycle-1/manifest-runs/*"
        }
      }
    },
    {
      "Sid": "ReadForecastRunObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${results_bucket_arn}/forecast-runs/*"
    },
    {
      "Sid": "ListForecastRunObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${results_bucket_arn}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "forecast-runs/*"
        }
      }
    }
  ]
}
